                <table class="w-full text-left text-xs border-collapse">
                    <thead class="sticky top-0 z-20 bg-slate-50">
                        <tr class="bg-slate-50 text-brand-textMain font-bold border-b border-slate-200 uppercase text-[10px] tracking-wider">
                            <th class="py-3 px-4 sticky top-0 bg-slate-50 z-20">TANGGAL</th>
