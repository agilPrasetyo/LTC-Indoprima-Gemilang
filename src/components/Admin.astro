---
import AdminQuiz from './AdminQuiz.astro';
import AdminSkillMap from './AdminSkillMap.astro';
import AdminSetting from './AdminSetting.astro';
---

<div class="animate-fadeIn flex-1 min-h-0 flex flex-col h-full">

    <!-- TAB 1: Manajemen Siswa (Default Active View - Pas 1 Layar Penuh) -->
    <div id="admin-tab-kelola-siswa" class="admin-tab-content flex-1 min-h-0 flex flex-col h-full">
        <div class="bg-white p-3.5 sm:p-4 rounded-[20px] border border-slate-100 shadow-sm flex flex-col flex-1 min-h-0 h-full">
            <div class="shrink-0 flex flex-col sm:flex-row sm:items-center justify-between gap-2.5 mb-2.5 border-b border-slate-100 pb-2">
                <div>
                    <h3 class="font-display font-bold text-base md:text-lg text-brand-textMain">Manajemen Siswa Aktif</h3>
                    <p class="text-[11px] text-brand-textSub">Kelola data pendaftaran siswa aktif program LTC</p>
                </div>
                <div class="flex flex-wrap items-center gap-2.5">
                    <button onclick="exportAdminSiswaToExcel()"
                        class="px-3.5 py-2 bg-emerald-600 hover:bg-emerald-700 active:scale-95 text-white font-bold rounded-xl text-xs flex items-center gap-2 transition-all shadow-md cursor-pointer">
                        <i class="fa-solid fa-file-excel"></i> Export Excel
                    </button>
                    <button onclick="openStudentModal()"
                        class="px-4 py-2 bg-brand-blue hover:bg-blue-700 text-white font-bold rounded-xl text-xs flex items-center gap-2 transition-all shadow-md">
                        <i class="fa-solid fa-user-plus"></i> Tambah Siswa Baru
                    </button>
                </div>
            </div>

            <!-- Baris Filter untuk Kelola Siswa -->
            <div class="shrink-0 grid grid-cols-1 sm:grid-cols-5 gap-2 p-2 sm:p-2.5 bg-slate-50/90 rounded-xl border border-slate-100 mb-2.5">
                <div>
                    <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-1">Pencarian</label>
                    <div class="relative">
                        <input type="text" id="filter-siswa-query" oninput="renderAdminSiswaTable(true)" placeholder="Cari nama, noreg..."
                            class="w-full pl-8 pr-2.5 py-1.5 bg-white border border-slate-200 rounded-xl text-xs outline-none focus:border-brand-blue transition-all">
                        <i class="fa-solid fa-magnifying-glass absolute left-2.5 top-2.5 text-slate-400 text-xs"></i>
                    </div>
                </div>
                <div>
                    <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-1">Filter Section</label>
                    <select id="filter-siswa-section" onchange="renderAdminSiswaTable(true)"
                        class="w-full px-2.5 py-1.5 bg-white border border-slate-200 rounded-xl text-xs outline-none focus:border-brand-blue transition-all">
                        <option value="">Semua Section</option>
                    </select>
                </div>
                <div>
                    <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-1">Filter Kelas</label>
                    <select id="filter-siswa-kelas" onchange="renderAdminSiswaTable(true)"
                        class="w-full px-2.5 py-1.5 bg-white border border-slate-200 rounded-xl text-xs outline-none focus:border-brand-blue transition-all">
                        <option value="">Semua Kelas</option>
                    </select>
                </div>
                <div>
                    <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-1">Filter Daerah Asal</label>
                    <select id="filter-siswa-asal" onchange="renderAdminSiswaTable(true)"
                        class="w-full px-2.5 py-1.5 bg-white border border-slate-200 rounded-xl text-xs outline-none focus:border-brand-blue transition-all">
                        <option value="">Semua Daerah Asal</option>
                    </select>
                </div>
                <div>
                    <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-1">Filter Sekolah</label>
                    <select id="filter-siswa-sekolah" onchange="renderAdminSiswaTable(true)"
                        class="w-full px-2.5 py-1.5 bg-white border border-slate-200 rounded-xl text-xs outline-none focus:border-brand-blue transition-all">
                        <option value="">Semua Sekolah</option>
                    </select>
                </div>
            </div>

            <!-- Tabel Siswa Aktif (Flex-1 Min-h-0 Pas Layar) -->
            <div class="flex-1 min-h-0 overflow-x-auto overflow-y-auto rounded-xl border border-slate-100 bg-white shadow-2xs">
                <table class="w-full text-left text-sm border-collapse">
                    <thead class="sticky top-0 z-30 bg-slate-50">
                        <tr class="text-brand-textSub text-xs uppercase border-b border-slate-200 bg-slate-50 font-bold">
                            <th class="py-2.5 px-3 font-bold sticky left-0 top-0 bg-slate-50 z-30 min-w-[170px] max-w-[170px] w-[170px] shadow-[2px_0_5px_-2px_rgba(0,0,0,0.1)] border-r border-slate-100 text-left">Aksi</th>
                            <th class="py-2.5 px-3 font-bold sticky left-[170px] top-0 bg-slate-50 z-30 min-w-[90px] max-w-[90px] w-[90px] shadow-[2px_0_5px_-2px_rgba(0,0,0,0.1)] border-r border-slate-100 text-left">NoReg</th>
                            <th class="py-2.5 px-3.5 font-bold sticky left-[260px] top-0 bg-slate-50 z-30 min-w-[200px] max-w-[200px] w-[200px] shadow-[2px_0_5px_-2px_rgba(0,0,0,0.1)] border-r border-slate-100 text-left">Nama</th>
                            <th class="py-2.5 px-3 font-bold min-w-[120px] sticky top-0 bg-slate-50 z-20">Departemen</th>
                            <th class="py-2.5 px-3 font-bold min-w-[130px] sticky top-0 bg-slate-50 z-20">Section</th>
                            <th class="py-2.5 px-3 font-bold min-w-[90px] sticky top-0 bg-slate-50 z-20">HK</th>
                            <th class="py-2.5 px-3 font-bold min-w-[95px] sticky top-0 bg-slate-50 z-20">Kelas</th>
                            <th class="py-2.5 px-3 font-bold min-w-[95px] sticky top-0 bg-slate-50 z-20">Masuk LTC</th>
                            <th class="py-2.5 px-3 font-bold min-w-[95px] sticky top-0 bg-slate-50 z-20">Distribusi</th>
                            <th class="py-2.5 px-3 font-bold min-w-[95px] sticky top-0 bg-slate-50 z-20">Akhir LTC</th>
                            <th class="py-2.5 px-3 font-bold min-w-[140px] sticky top-0 bg-slate-50 z-20">SPV</th>
                            <th class="py-2.5 px-3 font-bold min-w-[110px] sticky top-0 bg-slate-50 z-20">Daerah Asal</th>
                            <th class="py-2.5 px-3 font-bold min-w-[140px] sticky top-0 bg-slate-50 z-20">Sekolah</th>
                            <th class="py-2.5 px-3 font-bold min-w-[140px] sticky top-0 bg-slate-50 z-20">Tempat, Tanggal Lahir</th>
                            <th class="py-2.5 px-3 font-bold min-w-[160px] sticky top-0 bg-slate-50 z-20">Alamat</th>
                            <th class="py-2.5 px-3 font-bold min-w-[130px] sticky top-0 bg-slate-50 z-20">No. Telepon</th>
                        </tr>
                    </thead>
                    <tbody id="admin-siswa-tbody" class="divide-y divide-slate-50 text-xs font-semibold">
                        <!-- Diisi Dinamis lewat JavaScript -->
                    </tbody>
                </table>
            </div>

            <!-- Kontrol Paginasi Siswa Aktif (Pas Satu Layar) -->
            <div id="siswa-pagination-container" class="shrink-0 flex flex-col sm:flex-row sm:items-center justify-between gap-2 pt-2 mt-1 border-t border-slate-100 text-xs">
                <div class="flex items-center gap-3">
                    <span class="text-slate-500 font-semibold" id="siswa-pagination-info">
                        Menampilkan 0 dari 0 siswa
                    </span>
                    <div class="hidden sm:flex items-center gap-1.5 text-[11px] font-semibold text-slate-400">
                        <span>Tampil:</span>
                        <select id="siswa-page-size-select" onchange="changeSiswaPageSize(this.value)"
                            class="px-2 py-0.5 bg-white border border-slate-200 rounded-lg text-xs font-bold text-slate-700 outline-none cursor-pointer hover:border-brand-blue transition-colors">
                            <option value="10" selected>10 baris (Pas 1 Layar)</option>
                            <option value="15">15 baris</option>
                            <option value="25">25 baris</option>
                        </select>
                    </div>
                </div>
                <div class="flex items-center gap-1.5" id="siswa-pagination-controls"></div>
            </div>
        </div>
    </div>

    <!-- TAB 2: Manajemen Akun -->
    <div id="admin-tab-sync-akun" class="admin-tab-content hidden space-y-6">
        <!-- Tabel Manajemen Akun Terdaftar (Full Width) -->
        <div class="bg-white p-6 rounded-[24px] border border-slate-100 shadow-sm w-full">
            <div class="flex flex-col xl:flex-row xl:items-center justify-between gap-4 mb-6 border-b border-slate-100 pb-4">
                <div class="shrink-0">
                    <h3 class="font-display font-bold text-lg text-brand-textMain">Manajemen Akun Terdaftar</h3>
                </div>
                <div class="flex flex-wrap sm:flex-nowrap items-center gap-2.5 overflow-x-auto pb-1 sm:pb-0">
                    <div class="relative w-full sm:w-60 shrink-0">
                        <input type="text" id="filter-user-query" oninput="filterAdminUsersTable(true)" placeholder="Cari nama, email, noreg, role..."
                            class="w-full pl-9 pr-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs outline-none focus:border-brand-blue transition-all-300 shadow-sm font-semibold">
                        <i class="fa-solid fa-magnifying-glass absolute left-3 top-2.5 text-slate-400 text-xs"></i>
                    </div>
                    <button onclick="openUserRegisterModal()"
                        class="px-4 py-2 bg-brand-blue hover:bg-blue-700 active:scale-95 text-white font-bold rounded-xl text-xs flex items-center gap-2 transition-all-300 shadow-sm cursor-pointer whitespace-nowrap shrink-0">
                        <i class="fa-solid fa-user-plus"></i> Tambah Pengguna
                    </button>
                    <button onclick="exportAdminAkunToExcel()"
                        class="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 active:scale-95 text-white font-bold rounded-xl text-xs flex items-center gap-2 transition-all-300 shadow-sm cursor-pointer whitespace-nowrap shrink-0">
                        <i class="fa-solid fa-file-excel"></i> Export Excel
                    </button>
                    <button onclick="syncExternalToLocalAdmin()"
                        class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-brand-blue font-bold rounded-xl text-xs flex items-center gap-2 transition-all-300 cursor-pointer whitespace-nowrap shrink-0">
                        <i class="fa-solid fa-arrows-spin"></i> Sinkronisasi Siswa Eksternal
                    </button>
                </div>
            </div>
            <div class="overflow-x-auto max-h-[550px]" style="overflow-y: auto;">
                <table class="w-full text-left text-sm border-collapse">
                    <thead class="sticky top-0 z-20 bg-slate-50">
                        <tr class="text-brand-textSub text-xs uppercase border-b border-slate-200 bg-slate-50 font-bold">
                            <th class="py-3 px-4 font-semibold sticky top-0 bg-slate-50 z-20">User ID</th>
                            <th class="py-3 px-4 font-semibold sticky top-0 bg-slate-50 z-20">Nama Lengkap</th>
                            <th class="py-3 px-4 font-semibold sticky top-0 bg-slate-50 z-20">Email</th>
                            <th class="py-3 px-4 font-semibold sticky top-0 bg-slate-50 z-20">Role</th>
                            <th class="py-3 px-4 font-semibold sticky top-0 bg-slate-50 z-20">NoReg</th>
                            <th class="py-3 px-4 font-semibold sticky top-0 bg-slate-50 z-20">Password</th>
                            <th class="py-3 px-4 font-semibold text-right w-[160px] sticky top-0 bg-slate-50 z-20">Aksi</th>
                        </tr>
                    </thead>
                    <tbody id="admin-tbody" class="divide-y divide-slate-50">
                        <!-- Diisi Dinamis lewat JavaScript -->
                    </tbody>
                </table>
            </div>

            <!-- Kontrol Paginasi Manajemen Akun -->
            <div id="user-pagination-container" class="mt-4 pt-4 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs">
                <div id="user-pagination-info" class="text-slate-500 font-semibold">
                    Memuat data akun...
                </div>
                <div id="user-pagination-controls" class="flex items-center gap-1.5">
                    <!-- Tombol paginasi diinjeksi via JS -->
                </div>
            </div>
        </div>
    </div>

    <!-- TAB 3: Log Manpower Harian -->
    <div id="admin-tab-log-manpower" class="admin-tab-content hidden space-y-6">
        <div class="bg-white p-6 rounded-[24px] border border-slate-100 shadow-sm">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6 border-b border-slate-100 pb-4">
                <div>
                    <h3 class="font-display font-bold text-lg text-brand-textMain">Log Manpower Harian</h3>
                    <p class="text-xs text-brand-textSub">Kelola dan pantau seluruh catatan kinerja harian peserta LTC</p>
                </div>
                <div class="flex flex-wrap items-center gap-3">
                    <button onclick="exportAdminManpowerToExcel()"
                        class="px-4 py-2.5 bg-emerald-600 hover:bg-emerald-700 active:scale-95 text-white font-bold rounded-xl text-xs flex items-center gap-2 transition-all shadow-md cursor-pointer">
                        <i class="fa-solid fa-file-excel"></i> Export Excel
                    </button>
                    <button onclick="openManpowerLogModal()"
                        class="px-5 py-2.5 bg-brand-blue hover:bg-blue-700 text-white font-bold rounded-xl text-xs flex items-center gap-2 transition-all shadow-md">
                        <i class="fa-solid fa-plus"></i> Input Log Manpower
                    </button>
                </div>
            </div>

            <!-- Baris Filter untuk Log Manpower -->
            <div class="flex flex-col sm:flex-row gap-4 p-4 bg-slate-50 rounded-2xl border border-slate-100 mb-6">
                <div class="flex-1 relative">
                    <input type="text" id="filter-manpower-query" oninput="renderAdminManpowerTable(true)" placeholder="Cari NoReg, Nama Siswa, Bagian, SPV..."
                        class="w-full pl-9 pr-4 py-2 bg-white border border-slate-200 rounded-xl text-xs outline-none focus:border-brand-blue transition-all">
                    <i class="fa-solid fa-magnifying-glass absolute left-3 top-2.5 text-slate-400 text-xs"></i>
                </div>
                <div class="w-full sm:w-48">
                    <input type="date" id="filter-manpower-date" onchange="renderAdminManpowerTable(true)"
                        class="w-full px-3 py-2 bg-white border border-slate-200 rounded-xl text-xs outline-none focus:border-brand-blue transition-all">
                </div>
            </div>

            <!-- Tabel Log Manpower -->
            <div class="overflow-x-auto max-h-[550px]" style="overflow-y: auto;">
                <table class="w-full min-w-[1150px] table-fixed text-left text-sm border-collapse">
                    <thead class="sticky top-0 z-20 bg-slate-50">
                        <tr class="text-brand-textSub text-xs uppercase border-b border-slate-200 bg-slate-50 font-bold">
                            <th class="py-3.5 px-4 text-center w-[120px] whitespace-nowrap sticky top-0 bg-slate-50 z-20">Aksi</th>
                            <th class="py-3.5 px-4 font-semibold w-[95px] whitespace-nowrap sticky top-0 bg-slate-50 z-20">Tanggal</th>
                            <th class="py-3.5 px-4 font-semibold w-[90px] whitespace-nowrap sticky top-0 bg-slate-50 z-20">NoReg</th>
                            <th class="py-3.5 px-4 font-semibold w-[200px] whitespace-nowrap sticky top-0 bg-slate-50 z-20">Nama Lengkap</th>
                            <th class="py-3.5 px-4 font-semibold text-center w-[90px] whitespace-nowrap sticky top-0 bg-slate-50 z-20">Kehadiran</th>
                            <th class="py-3.5 px-4 font-semibold w-[210px] whitespace-nowrap sticky top-0 bg-slate-50 z-20">Detail Operasional<br><span class="text-[9px] font-normal text-slate-400 lowercase">(shift • bagian • mesin)</span></th>
                            <th class="py-3.5 px-4 font-semibold w-[220px] whitespace-nowrap sticky top-0 bg-slate-50 z-20">Hasil Produksi<br><span class="text-[9px] font-normal text-slate-400 lowercase">(target plan • aktual • reject)</span></th>
                            <th class="py-3.5 px-4 font-semibold sticky top-0 bg-slate-50 z-20">Keterangan</th>
                        </tr>
                    </thead>
                    <tbody id="admin-manpower-tbody" class="divide-y divide-slate-50 text-xs">
                        <tr>
                            <td colspan="8" class="py-8 text-center text-xs text-brand-textSub italic">Memuat log manpower harian...</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Kontrol Paginasi Log Manpower -->
            <div id="manpower-pagination-container" class="mt-4 pt-4 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs">
                <div id="manpower-pagination-info" class="text-slate-500 font-semibold">
                    Memuat log manpower...
                </div>
                <div id="manpower-pagination-controls" class="flex items-center gap-1.5">
                    <!-- Tombol paginasi diinjeksi via JS -->
                </div>
            </div>
        </div>
    </div>

    <!-- TAB 4: Kelola Turnover (Pas 1 Layar Penuh) -->
    <div id="admin-tab-kelola-turnover" class="admin-tab-content hidden flex-1 min-h-0 flex flex-col h-full">
        <div class="bg-white p-3.5 sm:p-4 rounded-[20px] border border-slate-100 shadow-sm flex flex-col flex-1 min-h-0 h-full">
            <div class="shrink-0 flex flex-col sm:flex-row sm:items-center justify-between gap-2.5 mb-2.5 border-b border-slate-100 pb-2">
                <div>
                    <h3 class="font-display font-bold text-base md:text-lg text-brand-textMain">Kelola Data Turnover</h3>
                    <p class="text-[11px] text-brand-textSub">Tambah, edit, dan hapus data riwayat turnover peserta LTC</p>
                </div>
                <div class="flex flex-wrap items-center gap-2.5">
                    <button onclick="exportAdminTurnoverToExcel()"
                        class="px-3.5 py-2 bg-emerald-600 hover:bg-emerald-700 active:scale-95 text-white font-bold rounded-xl text-xs flex items-center gap-2 transition-all shadow-md cursor-pointer">
                        <i class="fa-solid fa-file-excel"></i> Export Excel
                    </button>
                    <button onclick="openTurnoverModal()" class="px-4 py-2 bg-brand-blue hover:bg-blue-700 text-white font-bold rounded-xl text-xs flex items-center gap-2 transition-all shadow-md">
                        <i class="fa-solid fa-plus"></i> Tambah Turnover
                    </button>
                </div>
            </div>

            <!-- Baris Filter & Search untuk Kelola Turnover -->
            <div class="shrink-0 grid grid-cols-1 sm:grid-cols-3 gap-2 p-2 sm:p-2.5 bg-slate-50/90 rounded-xl border border-slate-100 mb-2.5">
                <!-- 1. Search Bar -->
                <div class="sm:col-span-2">
                    <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-1">Cari Data Turnover</label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 flex items-center pl-2.5 text-slate-400">
                            <i class="fa-solid fa-magnifying-glass text-xs"></i>
                        </span>
                        <input type="text" id="filter-admin-turnover-search" oninput="renderAdminTurnoverTable(true)"
                            placeholder="Cari nama, noreg, bagian, kota, sekolah, alasan, dll..."
                            class="w-full pl-8 pr-2.5 py-1.5 bg-white border border-slate-200 rounded-xl text-xs outline-none focus:border-brand-blue transition-all" />
                    </div>
                </div>

                <!-- 2. Filter Bulan -->
                <div>
                    <label class="block text-[10px] font-bold uppercase tracking-wider text-slate-400 mb-1">Filter Bulan Keluar</label>
                    <select id="filter-admin-turnover-bulan" onchange="renderAdminTurnoverTable(true)"
                        class="w-full px-2.5 py-1.5 bg-white border border-slate-200 rounded-xl text-xs outline-none focus:border-brand-blue transition-all">
                        <option value="">Semua Bulan</option>
                    </select>
                </div>
            </div>
            
            <!-- Tabel Kelola Turnover (Flex-1 Min-h-0 Pas Layar) -->
            <div class="flex-1 min-h-0 overflow-x-auto overflow-y-auto rounded-xl border border-slate-100 bg-white shadow-2xs">
                <table class="w-full text-left text-sm border-collapse">
                    <thead class="sticky top-0 z-20 bg-slate-50">
                        <tr class="text-brand-textSub text-xs uppercase border-b border-slate-200 bg-slate-50 font-bold">
                            <th class="py-2.5 px-3 font-semibold sticky left-0 top-0 bg-slate-50 z-30 min-w-[130px] max-w-[130px] w-[130px] shadow-[2px_0_5px_-2px_rgba(0,0,0,0.1)] border-r border-slate-100 text-left">Aksi</th>
                            <th class="py-2.5 px-3 font-semibold sticky top-0 bg-slate-50 z-20">NoReg</th>
                            <th class="py-2.5 px-3 font-semibold sticky top-0 bg-slate-50 z-20 min-w-[200px]">Nama</th>
                            <th class="py-2.5 px-3 font-semibold sticky top-0 bg-slate-50 z-20">Bagian</th>
                            <th class="py-2.5 px-3 font-semibold sticky top-0 bg-slate-50 z-20 min-w-[105px] whitespace-nowrap">Kelas</th>
                            <th class="py-2.5 px-3 font-semibold sticky top-0 bg-slate-50 z-20 min-w-[120px]">Kota / Daerah</th>
                            <th class="py-2.5 px-3 font-semibold sticky top-0 bg-slate-50 z-20 min-w-[140px]">Sekolah Asal</th>
                            <th class="py-2.5 px-3 font-semibold sticky top-0 bg-slate-50 z-20 min-w-[150px]">Tempat, Tanggal Lahir</th>
                            <th class="py-2.5 px-3 font-semibold sticky top-0 bg-slate-50 z-20 min-w-[180px]">Alamat</th>
                            <th class="py-2.5 px-3 font-semibold sticky top-0 bg-slate-50 z-20 min-w-[130px]">No. Telepon</th>
                            <th class="py-2.5 px-3 font-semibold sticky top-0 bg-slate-50 z-20 min-w-[100px] whitespace-nowrap">Tgl Masuk</th>
                            <th class="py-2.5 px-3 font-semibold sticky top-0 bg-slate-50 z-20 min-w-[100px] whitespace-nowrap">Tgl Keluar</th>
                            <th class="py-2.5 px-3 font-semibold sticky top-0 bg-slate-50 z-20">Alasan</th>
                            <th class="py-2.5 px-3 font-semibold sticky top-0 bg-slate-50 z-20">Keterangan</th>
                        </tr>
                    </thead>
                    <tbody id="admin-turnover-tbody" class="divide-y divide-slate-50 text-xs font-semibold">
                        <!-- Diisi Dinamis lewat JavaScript -->
                    </tbody>
                </table>
            </div>

            <!-- Kontrol Paginasi Kelola Turnover (Pas Satu Layar) -->
            <div id="turnover-pagination-container" class="shrink-0 flex flex-col sm:flex-row sm:items-center justify-between gap-2 pt-2 mt-1 border-t border-slate-100 text-xs">
                <div class="flex items-center gap-3">
                    <span class="text-slate-500 font-semibold" id="turnover-pagination-info">
                        Memuat data turnover...
                    </span>
                    <div class="hidden sm:flex items-center gap-1.5 text-[11px] font-semibold text-slate-400">
                        <span>Tampil:</span>
                        <select id="turnover-page-size-select" onchange="changeTurnoverPageSize(this.value)"
