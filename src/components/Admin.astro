                        <i class="fa-solid fa-file-excel"></i> Export Excel
                    </button>
                    <button onclick="openPopulasiModal(false)" class="px-5 py-2.5 bg-brand-blue hover:bg-blue-700 text-white font-bold rounded-xl text-xs flex items-center gap-2 transition-all shadow-md">
