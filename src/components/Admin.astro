    <!-- TAB 6: Manajemen K3 -->
    <div id="admin-tab-kelola-k3" class="admin-tab-content hidden space-y-6">
        <div class="bg-white p-6 rounded-[24px] border border-slate-100 shadow-sm space-y-4">
