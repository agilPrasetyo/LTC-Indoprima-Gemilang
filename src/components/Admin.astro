                </div>
                <div class="flex flex-wrap items-center gap-3">
                    <div class="relative w-full sm:w-48">
                        <input type="text" id="filter-populasi-tanggal" oninput="renderAdminPopulasiTable()" placeholder="Cari tanggal (cth: 2026-06-20)..." class="w-full pl-9 pr-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs outline-none focus:border-brand-blue transition-all-300 shadow-sm">
