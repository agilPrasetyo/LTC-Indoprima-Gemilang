<!-- ======================================================== -->
<!-- MODUL ADMIN QUIZ INTERAKTIF (LTC INDOPRIMA GEMILANG)      -->
<!-- Mengadopsi Konsep Quizizz / Wayground                      -->
<!-- ======================================================== -->

<div class="space-y-4">
    <!-- Header Modul Quiz (Clean Minimalist Enterprise Design) -->
    <div class="bg-white p-4 sm:p-5 rounded-2xl border border-slate-100 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
            <h3 class="font-display font-bold text-lg text-slate-800 leading-tight">Sistem Quiz & Evaluasi Teori</h3>
        </div>

        <!-- Sub-Tab Navigasi Quiz (Tanpa Ikon Berlebihan) -->
        <div class="flex items-center p-1 bg-slate-100/80 rounded-xl gap-1">
            <button id="tab-btn-quiz-rekap" onclick="switchQuizSubTab('rekap')"
                class="quiz-subtab-btn px-4 py-2 rounded-lg text-xs font-semibold transition-all bg-white text-[#0B3B82] shadow-xs">
                Rekap Nilai Siswa
            </button>
            <button id="tab-btn-quiz-soal" onclick="switchQuizSubTab('soal')"
                class="quiz-subtab-btn px-4 py-2 rounded-lg text-xs font-semibold text-slate-600 hover:text-slate-900 transition-all">
                Bank Soal & Section
            </button>
            <button id="tab-btn-quiz-jadwal" onclick="switchQuizSubTab('jadwal')"
                class="quiz-subtab-btn px-4 py-2 rounded-lg text-xs font-semibold text-slate-600 hover:text-slate-900 transition-all">
                Jadwal Ujian
            </button>
        </div>
    </div>

    <!-- ======================================================== -->
    <!-- SUB-TAB 1: REKAP NILAI SISWA                            -->
    <!-- ======================================================== -->
    <div id="quiz-subview-rekap" class="quiz-subview space-y-4">
        
        <!-- BARIS 1: 4 Executive KPI Cards (Tipografi Bersih Tanpa Ikon AI) -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-3.5">
            <!-- Card 1: Ujian Aktif -->
            <div class="bg-white p-4 rounded-2xl border border-slate-100 shadow-sm flex flex-col justify-between">
                <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Ujian Aktif</span>
                <div class="my-1.5">
                    <span id="lms-kpi-ujian-aktif" class="text-2xl font-bold text-slate-800">0</span>
                    <span class="text-xs font-medium text-slate-400 ml-1">Sesi</span>
                </div>
                <div class="flex items-center gap-1.5 text-[11px] text-emerald-600 font-medium">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    <span id="lms-kpi-ujian-status">Sedang berlangsung</span>
                </div>
            </div>

            <!-- Card 2: Partisipasi Siswa -->
            <div class="bg-white p-4 rounded-2xl border border-slate-100 shadow-sm flex flex-col justify-between">
                <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Partisipasi Siswa</span>
                <div class="my-1.5">
                    <span id="lms-kpi-partisipasi" class="text-2xl font-bold text-slate-800">0%</span>
                </div>
                <div class="text-[11px] text-slate-400 truncate" id="lms-kpi-partisipasi-sub">0 dari 0 siswa telah ujian</div>
            </div>

            <!-- Card 3: Tingkat Kelulusan -->
            <div class="bg-white p-4 rounded-2xl border border-slate-100 shadow-sm flex flex-col justify-between">
                <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Tingkat Kelulusan</span>
                <div class="my-1.5">
                    <span id="lms-kpi-pass-rate" class="text-2xl font-bold text-slate-800">0%</span>
                </div>
                <div class="text-[11px] text-slate-400">Standar KKM minimal 75.0</div>
            </div>

            <!-- Card 4: Rata-Rata Nilai Teori -->
            <div class="bg-white p-4 rounded-2xl border border-slate-100 shadow-sm flex flex-col justify-between">
                <span class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Rata-Rata Teori</span>
                <div class="my-1.5">
                    <span id="lms-kpi-avg-score" class="text-2xl font-bold text-slate-800">0.0</span>
                    <span class="text-xs font-medium text-slate-400 ml-1">/ 100</span>
                </div>
                <div class="text-[11px] text-slate-400">Akumulasi seluruh kelas 1 - 5</div>
            </div>
        </div>

        <!-- BARIS 2: Grafik Perbandingan Rata-Rata Nilai Antar Kelas -->
        <div class="bg-white p-5 rounded-2xl border border-slate-100 shadow-sm space-y-3">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-100 pb-3">
                <div>
                    <h4 class="font-bold text-slate-800 text-sm">Perbandingan Rata-Rata Nilai Antar Kelas</h4>
                </div>
                <div class="flex items-center gap-2">
                    <span class="px-2.5 py-1 rounded-md text-[11px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                        Standar KKM: 75
                    </span>
                </div>
            </div>

            <!-- Canvas Container -->
            <div class="relative w-full h-52 sm:h-60">
                <canvas id="lms-class-avg-chart"></canvas>
            </div>
        </div>
        <div class="bg-white p-5 sm:p-6 rounded-2xl border border-slate-100 shadow-sm space-y-4">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-100 pb-4">
                <div>
                    <h4 class="font-bold text-slate-800 text-base leading-tight">Rekap Nilai Siswa per Tingkat Kelas</h4>
                </div>
                <div class="flex items-center gap-3">
                    <button onclick="refreshQuizData()" class="px-3.5 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold rounded-xl flex items-center gap-1.5 transition-all">
                        <i class="fa-solid fa-rotate"></i> Refresh
                    </button>
                </div>
            </div>

            <!-- Filter & Search Bar -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 p-3 bg-slate-50 rounded-2xl border border-slate-100">
                <div>
                    <input type="text" id="filter-quiz-rekap-query" oninput="renderQuizRekapTable(true)" placeholder="Cari siswa / NoReg..."
                        class="w-full px-3 py-2 bg-white border border-slate-200 rounded-xl text-xs outline-none focus:border-indigo-500 font-semibold">
                </div>
                <div>
                    <select id="filter-quiz-rekap-status" onchange="renderQuizRekapTable(true)"
                        class="w-full px-3 py-2 bg-white border border-slate-200 rounded-xl text-xs outline-none focus:border-indigo-500 font-semibold">
                        <option value="">Semua Status Kelulusan</option>
                        <option value="lulus">Lulus Semua (>= 75)</option>
                        <option value="remidi">Ada Remidi (< 75)</option>
                        <option value="belum">Belum Ada Nilai</option>
                    </select>
                </div>
                <div class="flex items-center justify-end">
                    <span class="text-xs text-slate-500 font-semibold" id="rekap-summary-count">Menampilkan: 0 siswa</span>
                </div>
            </div>

            <!-- Tabel Rekap Nilai -->
            <div class="overflow-x-auto max-h-[550px]" style="overflow-y: auto;">
                <table class="w-full text-left text-xs border-collapse">
                    <thead class="sticky top-0 z-20 bg-slate-50 text-slate-600 uppercase font-bold border-b border-slate-200">
                        <tr>
                            <th class="py-3 px-3 min-w-[75px] whitespace-nowrap">NoReg</th>
                            <th class="py-3 px-3 min-w-[180px] whitespace-nowrap">Nama Siswa</th>
                            <th class="py-3 px-3 text-center min-w-[75px] whitespace-nowrap">Kelas 1</th>
                            <th class="py-3 px-3 text-center min-w-[75px] whitespace-nowrap">Kelas 2</th>
                            <th class="py-3 px-3 text-center min-w-[75px] whitespace-nowrap">Kelas 3</th>
                            <th class="py-3 px-3 text-center min-w-[75px] whitespace-nowrap">Kelas 4</th>
                            <th class="py-3 px-3 text-center min-w-[75px] whitespace-nowrap">Kelas 5</th>
                            <th class="py-3 px-3 text-center min-w-[110px] whitespace-nowrap">Rata-Rata Teori</th>
                            <th class="py-3 px-3 text-center min-w-[130px] whitespace-nowrap">Status KKM</th>
                            <th class="py-3 px-3 text-center min-w-[190px] whitespace-nowrap">Aksi Admin</th>
                        </tr>
                    </thead>
                    <tbody id="quiz-rekap-tbody" class="divide-y divide-slate-100 font-semibold">
                        <!-- Diisi secara dinamis oleh JavaScript -->
                    </tbody>
                </table>
            </div>

            <!-- Kontrol Paginasi Rekap Nilai Quiz (25 Siswa per Halaman) -->
            <div id="quiz-rekap-pagination-container" class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-4 border-t border-slate-100 text-xs">
                <div class="text-slate-500 font-semibold" id="quiz-rekap-pagination-info">
                    Menampilkan 0 dari 0 siswa
                </div>
                <div class="flex items-center gap-1.5" id="quiz-rekap-pagination-controls"></div>
            </div>
        </div>
    </div>

    <!-- ======================================================== -->
    <!-- SUB-TAB 2: BANK SOAL & SECTION                          -->
    <!-- ======================================================== -->
    <div id="quiz-subview-soal" class="quiz-subview hidden space-y-6">
        <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
            <!-- Kolom Kiri: Manajemen Section / Stasiun Kerja -->
            <div class="bg-white p-6 rounded-[24px] border border-slate-100 shadow-sm space-y-4 lg:col-span-1">
                <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                    <h4 class="font-bold text-slate-800 text-sm">Daftar Section</h4>
                    <button onclick="openModalAddSection()" class="p-1.5 bg-indigo-50 hover:bg-indigo-100 text-indigo-600 rounded-lg text-xs font-bold transition-all" title="Tambah Section">
                        <i class="fa-solid fa-plus"></i>
                    </button>
                </div>
                <div id="quiz-section-list" class="space-y-2 max-h-[500px] overflow-y-auto">
                    <!-- Diisi dinamis -->
                </div>
            </div>

            <!-- Kolom Kanan: Bank Soal Pilihan Ganda -->
            <div class="bg-white p-6 rounded-[24px] border border-slate-100 shadow-sm space-y-4 lg:col-span-3">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-100 pb-4">
                    <div>
                        <h4 class="font-bold text-slate-800 text-base leading-tight" id="current-section-title">Daftar Soal</h4>
                    </div>
                    <div class="flex flex-wrap items-center gap-2">
                        <button onclick="downloadQuizTemplate('csv')" class="px-3 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold rounded-xl flex items-center gap-1.5 transition-all" title="Download Template CSV">
                            <i class="fa-solid fa-download"></i> Template CSV
                        </button>
                        <button onclick="downloadQuizTemplate('xlsx')" class="px-3 py-2 bg-emerald-50 hover:bg-emerald-100 text-emerald-700 text-xs font-bold rounded-xl flex items-center gap-1.5 transition-all" title="Download Template Excel">
                            <i class="fa-solid fa-file-excel"></i> Template Excel
                        </button>
                        <button onclick="openModalImportSoal()" class="px-3.5 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold rounded-xl flex items-center gap-1.5 transition-all shadow-sm">
                            <i class="fa-solid fa-file-import"></i> Import Excel/CSV
                        </button>
                        <button onclick="openModalAddQuestion()" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold rounded-xl flex items-center gap-1.5 transition-all shadow-sm">
                            <i class="fa-solid fa-plus"></i> Tambah Soal
                        </button>
                    </div>
                </div>

                <!-- Daftar Kartu Soal -->
                <div id="quiz-question-container" class="space-y-3 max-h-[550px] overflow-y-auto pr-1">
                    <!-- Diisi dinamis -->
                </div>
            </div>
        </div>
    </div>

    <!-- ======================================================== -->
    <!-- SUB-TAB 3: JADWAL UJIAN (QUIZ SCHEDULER)                 -->
    <!-- ======================================================== -->
    <div id="quiz-subview-jadwal" class="quiz-subview hidden space-y-6">
        <div class="bg-white p-6 rounded-[24px] border border-slate-100 shadow-sm space-y-4">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-100 pb-4">
                <div>
                    <h4 class="font-bold text-slate-800 text-base leading-tight">Jadwal Ujian Aktif & Terjadwal</h4>
                </div>
                <div>
                    <button onclick="openModalAddSchedule()" class="px-4 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold rounded-xl flex items-center gap-2 transition-all shadow-sm">
                        <i class="fa-solid fa-calendar-plus"></i> Jadwalkan Ujian Baru
                    </button>
                </div>
            </div>

            <!-- Tabel Jadwal Ujian -->
            <div class="overflow-x-auto max-h-[550px]" style="overflow-y: auto;">
                <table class="w-full text-left text-xs border-collapse">
                    <thead class="sticky top-0 z-20 bg-slate-50 text-slate-600 uppercase font-bold border-b border-slate-200">
                        <tr>
                            <th class="py-3 px-3 min-w-[180px]">Judul Ujian</th>
                            <th class="py-3 px-3 min-w-[120px]">Section</th>
                            <th class="py-3 px-3 text-center min-w-[90px]">Kelas</th>
                            <th class="py-3 px-3 min-w-[140px]">Jadwal Mulai</th>
                            <th class="py-3 px-3 min-w-[140px]">Jadwal Selesai</th>
                            <th class="py-3 px-3 text-center min-w-[80px]">Durasi</th>
                            <th class="py-3 px-3 text-center min-w-[100px] whitespace-nowrap">Peserta</th>
                            <th class="py-3 px-3 text-center min-w-[100px]">Status</th>
                            <th class="py-3 px-3 text-center min-w-[120px]">Aksi</th>
                        </tr>
                    </thead>
                    <tbody id="quiz-schedule-tbody" class="divide-y divide-slate-100">
                        <!-- Diisi secara dinamis oleh JavaScript -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- ======================================================== -->
<!-- MODAL 1: TAMBAH / EDIT SECTION                          -->
<!-- ======================================================== -->
<div id="modal-quiz-section" class="fixed inset-0 z-[9999] bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4 hidden animate-fadeIn">
    <div class="bg-white rounded-3xl max-w-md w-full p-6 shadow-2xl space-y-4 border border-slate-100">
        <div class="flex items-center justify-between border-b border-slate-100 pb-3">
            <h4 class="font-bold text-slate-800 text-sm" id="modal-section-title">Tambah Section Baru</h4>
            <button onclick="closeModalQuizSection()" class="text-slate-400 hover:text-slate-600 text-sm">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <input type="hidden" id="quiz-section-id">
        <div class="space-y-3 text-xs">
            <div>
                <label class="block font-bold text-slate-600 mb-1">Nama Section / Stasiun Kerja *</label>
                <input type="text" id="quiz-section-name" placeholder="Contoh: Grinding / Furan / Melting"
                    class="w-full px-3 py-2 border border-slate-200 rounded-xl outline-none focus:border-indigo-500 font-semibold">
            </div>
            <div>
                <label class="block font-bold text-slate-600 mb-1">Deskripsi Singkat</label>
                <textarea id="quiz-section-desc" rows="2" placeholder="Deskripsi materi dan lingkup stasiun kerja..."
                    class="w-full px-3 py-2 border border-slate-200 rounded-xl outline-none focus:border-indigo-500 font-semibold"></textarea>
            </div>
        </div>
        <div class="flex items-center justify-end gap-2 pt-3 border-t border-slate-100">
            <button onclick="closeModalQuizSection()" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold rounded-xl transition-all">
                Batal
            </button>
            <button onclick="saveQuizSection()" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold rounded-xl transition-all shadow-sm">
                Simpan Section
            </button>
        </div>
    </div>
</div>

<!-- ======================================================== -->
<!-- MODAL 2: TAMBAH / EDIT SOAL PILIHAN GANDA               -->
<!-- ======================================================== -->
<div id="modal-quiz-question" class="fixed inset-0 z-[9999] bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4 hidden animate-fadeIn">
    <div class="bg-white rounded-3xl max-w-2xl w-full p-6 shadow-2xl space-y-4 border border-slate-100 max-h-[90vh] overflow-y-auto">
        <div class="flex items-center justify-between border-b border-slate-100 pb-3">
            <h4 class="font-bold text-slate-800 text-sm" id="modal-question-title">Tambah Soal Pilihan Ganda</h4>
            <button onclick="closeModalQuizQuestion()" class="text-slate-400 hover:text-slate-600 text-sm">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <input type="hidden" id="quiz-question-id">
        <div class="space-y-4 text-xs">
            <div>
                <label class="block font-bold text-slate-600 mb-1">Section / Stasiun Kerja *</label>
                <select id="quiz-question-section" class="w-full px-3 py-2 border border-slate-200 rounded-xl outline-none focus:border-indigo-500 font-semibold">
                    <!-- Diisi dinamis -->
                </select>
            </div>
            <div>
                <label class="block font-bold text-slate-600 mb-1">Pertanyaan / Soal *</label>
                <textarea id="quiz-question-text" rows="3" placeholder="Tuliskan pertanyaan di sini..."
                    class="w-full px-3 py-2 border border-slate-200 rounded-xl outline-none focus:border-indigo-500 font-semibold"></textarea>
            </div>
            <div class="space-y-2">
                <label class="block font-bold text-slate-600">Pilihan Jawaban & Kunci Jawaban *</label>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div class="p-3 border border-slate-200 rounded-xl flex items-center gap-2 bg-slate-50/50">
                        <input type="radio" name="quiz-correct-answer" id="radio-ans-A" value="A" class="w-4 h-4 text-indigo-600 cursor-pointer">
                        <span class="font-bold text-slate-700 w-5">A.</span>
                        <input type="text" id="quiz-opt-A" placeholder="Teks Pilihan A" class="w-full px-2 py-1.5 bg-white border border-slate-200 rounded-lg outline-none font-semibold text-xs">
                    </div>
                    <div class="p-3 border border-slate-200 rounded-xl flex items-center gap-2 bg-slate-50/50">
                        <input type="radio" name="quiz-correct-answer" id="radio-ans-B" value="B" class="w-4 h-4 text-indigo-600 cursor-pointer">
                        <span class="font-bold text-slate-700 w-5">B.</span>
                        <input type="text" id="quiz-opt-B" placeholder="Teks Pilihan B" class="w-full px-2 py-1.5 bg-white border border-slate-200 rounded-lg outline-none font-semibold text-xs">
                    </div>
                    <div class="p-3 border border-slate-200 rounded-xl flex items-center gap-2 bg-slate-50/50">
                        <input type="radio" name="quiz-correct-answer" id="radio-ans-C" value="C" class="w-4 h-4 text-indigo-600 cursor-pointer">
                        <span class="font-bold text-slate-700 w-5">C.</span>
                        <input type="text" id="quiz-opt-C" placeholder="Teks Pilihan C" class="w-full px-2 py-1.5 bg-white border border-slate-200 rounded-lg outline-none font-semibold text-xs">
                    </div>
                    <div class="p-3 border border-slate-200 rounded-xl flex items-center gap-2 bg-slate-50/50">
                        <input type="radio" name="quiz-correct-answer" id="radio-ans-D" value="D" class="w-4 h-4 text-indigo-600 cursor-pointer">
                        <span class="font-bold text-slate-700 w-5">D.</span>
                        <input type="text" id="quiz-opt-D" placeholder="Teks Pilihan D" class="w-full px-2 py-1.5 bg-white border border-slate-200 rounded-lg outline-none font-semibold text-xs">
                    </div>
                </div>
                <p class="text-[11px] text-slate-400 italic">Pilih bulatan radio di samping huruf untuk menetapkan kunci jawaban yang benar.</p>
            </div>
        </div>
        <div class="flex items-center justify-end gap-2 pt-3 border-t border-slate-100">
            <button onclick="closeModalQuizQuestion()" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold rounded-xl transition-all">
                Batal
            </button>
            <button onclick="saveQuizQuestion()" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold rounded-xl transition-all shadow-sm">
                Simpan Soal
            </button>
        </div>
    </div>
</div>

<!-- ======================================================== -->
<!-- MODAL 3: IMPORT SOAL DARI EXCEL / CSV                    -->
<!-- ======================================================== -->
<div id="modal-quiz-import" class="fixed inset-0 z-[9999] bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4 hidden animate-fadeIn">
    <div class="bg-white rounded-3xl max-w-2xl w-full p-6 shadow-2xl space-y-4 border border-slate-100 max-h-[90vh] overflow-y-auto">
        <div class="flex items-center justify-between border-b border-slate-100 pb-3">
            <h4 class="font-bold text-slate-800 text-sm">Import Soal Massal dari Excel / CSV</h4>
            <button onclick="closeModalQuizImport()" class="text-slate-400 hover:text-slate-600 text-sm">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <div class="space-y-4 text-xs">
            <div class="p-3 bg-amber-50 border border-amber-200 rounded-xl text-amber-800 text-[11.5px] leading-relaxed">
                <p class="font-bold mb-1"><i class="fa-solid fa-circle-info mr-1"></i> Format Kolom Excel/CSV Wajib:</p>
                <code>Section, Pertanyaan, Pilihan_A, Pilihan_B, Pilihan_C, Pilihan_D, Kunci_Jawaban</code>
                <p class="mt-1">Gunakan template yang telah disediakan agar format kolom terbaca sempurna oleh sistem.</p>
            </div>

            <div>
                <label class="block font-bold text-slate-600 mb-1">Pilih File (.xlsx / .xls / .csv)</label>
                <input type="file" id="quiz-import-file" accept=".csv, .xlsx, .xls" onchange="previewQuizImportFile()"
                    class="w-full px-3 py-2 border border-slate-200 rounded-xl text-xs bg-slate-50 cursor-pointer">
            </div>

            <!-- Preview Tabel Soal yang Akan Di-import -->
            <div id="quiz-import-preview-wrapper" class="hidden space-y-2">
                <div class="flex items-center justify-between">
                    <span class="font-bold text-slate-700" id="quiz-import-count">Preview: 0 soal terdeteksi</span>
                </div>
                <div class="max-h-60 overflow-y-auto border border-slate-200 rounded-xl">
                    <table class="w-full text-left text-[11px]">
                        <thead class="bg-slate-100 text-slate-600 font-bold sticky top-0">
                            <tr>
                                <th class="p-2">Section</th>
                                <th class="p-2">Pertanyaan</th>
                                <th class="p-2">Kunci</th>
                            </tr>
                        </thead>
                        <tbody id="quiz-import-tbody" class="divide-y divide-slate-100"></tbody>
                    </table>
                </div>
            </div>
