  function updateCertPreview() {
    const fmt = document.getElementById('cert-nomor-format')?.value || 'LTC/P5/{YYYY}/{BATCH}/{NO}';
    const currentYear = new Date().getFullYear();
    const rendered = fmt
      .replace('{YYYY}', currentYear)
      .replace('{BATCH}', '2026-A')
      .replace('{NO}', '001');
    const previewEl = document.getElementById('cert-nomor-preview');
    if (previewEl) previewEl.innerText = rendered;
  }
  window.updateCertPreview = updateCertPreview;

