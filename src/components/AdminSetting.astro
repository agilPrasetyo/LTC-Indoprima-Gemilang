  let machineCache = [];
  async function fetchMachineList() {
    const tbody = document.getElementById('setting-machines-tbody');
    try {
      const res = await executeRpcCall('getMasterMachines', [5]);
      machineCache = res.data || [];
      const badgeCount = document.getElementById('nav-machines-count');
      if (badgeCount) badgeCount.innerText = machineCache.length;
      renderMachineTable(machineCache);
    } catch (err) {
      if (tbody) tbody.innerHTML = `<tr><td colspan="6" class="py-4 text-center text-rose-500">${err.message}</td></tr>`;
    }
  }
  window.fetchMachineList = fetchMachineList;

  function renderMachineTable(list) {
    const tbody = document.getElementById('setting-machines-tbody');
    if (!tbody) return;
    if (list.length === 0) {
      tbody.innerHTML = '<tr><td colspan="6" class="py-8 text-center text-slate-400">Tidak ada data mesin ditemukan.</td></tr>';
      return;
    }
    tbody.innerHTML = list.map(m => {
      let statusBadge = 'bg-slate-100 text-slate-500';
      let statusDot = 'bg-slate-400';
      if (m.status === 'AKTIF') {
        statusBadge = 'bg-emerald-50 text-emerald-700 border border-emerald-200/60';
        statusDot = 'bg-emerald-500';
      } else if (m.status === 'MAINTENANCE') {
        statusBadge = 'bg-amber-50 text-amber-700 border border-amber-200/60';
        statusDot = 'bg-amber-500';
      }
      return `
        <tr class="hover:bg-slate-50/60 transition-colors">
          <td class="py-3 px-4 font-mono font-bold text-slate-900">${m.kode_mesin}</td>
          <td class="py-3 px-4 font-semibold text-slate-800">${m.nama_mesin}</td>
          <td class="py-3 px-3"><span class="px-2.5 py-1 bg-slate-100 text-slate-700 rounded-md font-semibold text-[11px]">${m.section || '-'}</span></td>
          <td class="py-3 px-3 text-slate-500 text-[11px] font-mono">${m.tipe_kapasitas || '-'}</td>
          <td class="py-3 px-3 text-center">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-semibold ${statusBadge}">
              <span class="w-1.5 h-1.5 rounded-full ${statusDot}"></span>
              ${m.status}
            </span>
          </td>
          <td class="py-3 px-4 text-center">
            <div class="flex items-center justify-center gap-1">
              <button onclick="editMachine('${m.id}')" class="p-1.5 hover:bg-slate-100 text-slate-600 hover:text-blue-600 rounded-md transition-all cursor-pointer"><i class="fa-solid fa-pen-to-square"></i></button>
              <button onclick="deleteMachine('${m.id}', '${m.kode_mesin}')" class="p-1.5 hover:bg-rose-50 text-slate-400 hover:text-rose-600 rounded-md transition-all cursor-pointer"><i class="fa-solid fa-trash"></i></button>
            </div>
          </td>
        </tr>
      `;
    }).join('');
  }

  function filterMachineTable() {
    const q = (document.getElementById('search-setting-machine')?.value || '').toLowerCase().trim();
    if (!q) {
      renderMachineTable(machineCache);
      return;
    }
    const filtered = machineCache.filter(m => 
      (m.nama_mesin || '').toLowerCase().includes(q) ||
      (m.kode_mesin || '').toLowerCase().includes(q) ||
      (m.section || '').toLowerCase().includes(q)
    );
    renderMachineTable(filtered);
  }
  window.filterMachineTable = filterMachineTable;

  function openMachineModal(mc = null) {
    updateSectionDropdowns();
    document.getElementById('form-machine-id').value = mc ? mc.id : '';
    document.getElementById('form-machine-kode').value = mc ? mc.kode_mesin : '';
    document.getElementById('form-machine-nama').value = mc ? mc.nama_mesin : '';
    
    const selSection = document.getElementById('form-machine-section');
    if (selSection) {
      if (mc && mc.section) {
        if (!Array.from(selSection.options).some(o => o.value === mc.section)) {
          selSection.add(new Option(mc.section, mc.section));
        }
        selSection.value = mc.section;
      } else {
        selSection.value = '';
      }
    }

    document.getElementById('form-machine-kapasitas').value = mc ? mc.tipe_kapasitas : '';
    document.getElementById('form-machine-status').value = mc ? mc.status : 'AKTIF';
    document.getElementById('modal-machine-title').innerText = mc ? 'Edit Data Mesin' : 'Tambah Mesin Baru';
    document.getElementById('modal-setting-machine')?.classList.remove('hidden');
  }
  function closeMachineModal() {
    document.getElementById('modal-setting-machine')?.classList.add('hidden');
  }
  window.openMachineModal = openMachineModal;
  window.closeMachineModal = closeMachineModal;

  window.editMachine = (id) => {
    const m = machineCache.find(x => x.id === id);
    if (m) openMachineModal(m);
  };

  function notifyMasterOperationalUpdated() {
    window.dispatchEvent(new CustomEvent('master-operational-updated'));
    try {
      if (typeof BroadcastChannel !== 'undefined') {
        const ch = new BroadcastChannel('ltc-operational-sync');
        ch.postMessage({ type: 'MASTER_UPDATED', timestamp: Date.now() });
      }
      localStorage.setItem('ltc-master-operational-timestamp', Date.now());
    } catch (err) {}
  }

  window.deleteMachine = async (id, kode) => {
    if (!confirm(`Pindahkan mesin "${kode}" ke Recycle Bin?`)) return;
    try {
      const res = await executeRpcCall('deleteMasterMachine', [id, 5]);
      if (res.success) {
        showSettingToast(`Mesin ${kode} dipindahkan ke Recycle Bin.`);
        fetchMachineList();
        fetchRecycleBinItems();
        notifyMasterOperationalUpdated();
      } else {
        showSettingToast(res.message, 'error');
      }
    } catch (err) {
      showSettingToast(err.message, 'error');
    }
  };

  async function submitMachineForm() {
    const kode_mesin = document.getElementById('form-machine-kode')?.value.trim();
    const nama_mesin = document.getElementById('form-machine-nama')?.value.trim();
    if (!kode_mesin || !nama_mesin) return alert('Kode mesin dan nama mesin wajib diisi!');

    const payload = {
      id: document.getElementById('form-machine-id')?.value || undefined,
      kode_mesin,
      nama_mesin,
      section: document.getElementById('form-machine-section')?.value.trim(),
      tipe_kapasitas: document.getElementById('form-machine-kapasitas')?.value.trim(),
      status: document.getElementById('form-machine-status')?.value || 'AKTIF'
    };

    try {
      const res = await executeRpcCall('saveMasterMachine', [payload, 5]);
      if (res.success) {
        showSettingToast('Mesin berhasil disimpan!');
        closeMachineModal();
        fetchMachineList();
        notifyMasterOperationalUpdated();
      } else {
        showSettingToast(res.message, 'error');
      }
    } catch (err) {
      showSettingToast(err.message, 'error');
    }
  }
  window.submitMachineForm = submitMachineForm;

  // ==============================================================================
  // 6. LOG AKTIVITAS ADMIN (AUDIT TRAIL)
  // ==============================================================================
  async function fetchActivityLogs() {
    const tbody = document.getElementById('setting-logs-tbody');
    try {
      const res = await executeRpcCall('getAdminActivityLogs', [5, 50]);
      const list = res.data || [];
      if (!tbody) return;
      if (list.length === 0) {
        tbody.innerHTML = '<tr><td colspan="5" class="py-8 text-center text-slate-400">Belum ada riwayat aktivitas.</td></tr>';
        return;
      }
      tbody.innerHTML = list.map(log => {
        let badgeColor = 'bg-slate-100 text-slate-600';
        if (log.action_type === 'CREATE') badgeColor = 'bg-emerald-50 text-emerald-700 border border-emerald-200/60';
        else if (log.action_type === 'UPDATE') badgeColor = 'bg-blue-50 text-blue-700 border border-blue-200/60';
        else if (log.action_type === 'DELETE') badgeColor = 'bg-rose-50 text-rose-700 border border-rose-200/60';
        else if (log.action_type === 'RESTORE') badgeColor = 'bg-purple-50 text-purple-700 border border-purple-200/60';
        else if (log.action_type === 'LOGIN') badgeColor = 'bg-amber-50 text-amber-700 border border-amber-200/60';

        const timeStr = log.created_at ? new Date(log.created_at).toLocaleString('id-ID', { dateStyle: 'short', timeStyle: 'short' }) : '-';

        return `
          <tr class="hover:bg-slate-50/60 transition-colors">
            <td class="py-3 px-4 font-mono text-[11px] text-slate-400 whitespace-nowrap">${timeStr}</td>
            <td class="py-3 px-3 font-semibold text-slate-900">${log.admin_username}</td>
            <td class="py-3 px-3"><span class="px-2 py-0.5 rounded-full text-[10px] font-bold ${badgeColor}">${log.action_type}</span></td>
            <td class="py-3 px-3"><span class="font-mono text-[10px] text-slate-500 uppercase tracking-wider">${log.target_module}</span></td>
            <td class="py-3 px-4 text-slate-700 text-xs">${log.description}</td>
          </tr>
        `;
      }).join('');
    } catch (err) {
      if (tbody) tbody.innerHTML = `<tr><td colspan="5" class="py-4 text-center text-rose-500">${err.message}</td></tr>`;
    }
  }
  window.fetchActivityLogs = fetchActivityLogs;

  // ==============================================================================
  // 7. RECYCLE BIN & DATA RECOVERY
  // ==============================================================================
  let recycleCache = [];
  async function fetchRecycleBinItems() {
    const tbody = document.getElementById('setting-recycle-tbody');
    try {
      const res = await executeRpcCall('getRecycleBinItems', [5]);
      recycleCache = res.data || [];
      const badge = document.getElementById('nav-recycle-badge');
      if (badge) {
        badge.innerText = recycleCache.length;
        badge.className = recycleCache.length > 0 
          ? 'px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-100 text-rose-700' 
          : 'px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-100 text-slate-600';
      }

      if (!tbody) return;
      if (recycleCache.length === 0) {
        tbody.innerHTML = '<tr><td colspan="5" class="py-8 text-center text-slate-400">Tempat sampah kosong. Tidak ada data terhapus.</td></tr>';
        return;
      }

      tbody.innerHTML = recycleCache.map(b => {
        const timeStr = b.deleted_at ? new Date(b.deleted_at).toLocaleString('id-ID', { dateStyle: 'short', timeStyle: 'short' }) : '-';
        return `
          <tr class="hover:bg-slate-50/60 transition-colors">
            <td class="py-3 px-4"><span class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-slate-100 text-slate-700">${b.entity_type}</span></td>
