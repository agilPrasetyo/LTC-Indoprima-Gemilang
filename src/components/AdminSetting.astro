        notifyMasterOperationalUpdated();
      } else {
        showSettingToast(res.message, 'error');
      }
    } catch (err) {
      showSettingToast(err.message, 'error');
    }
  };

  async function submitSectionForm() {
    const nama_section = document.getElementById('form-section-nama')?.value.trim();
    if (!nama_section) return alert('Nama section wajib diisi!');
    const payload = {
      id: document.getElementById('form-section-id')?.value || undefined,
      nama_section: nama_section.toUpperCase(),
      departemen: document.getElementById('form-section-departemen')?.value.trim() || 'Produksi',
      keterangan: document.getElementById('form-section-keterangan')?.value.trim(),
      status: document.getElementById('form-section-status')?.value || 'AKTIF'
    };

    try {
      const res = await executeRpcCall('saveMasterSection', [payload, 5]);
      if (res.success) {
        showSettingToast('Section berhasil disimpan!');
        closeSectionModal();
        fetchSectionList();
        notifyMasterOperationalUpdated();
      } else {
        showSettingToast(res.message, 'error');
      }
    } catch (err) {
      showSettingToast(err.message, 'error');
    }
  }
  window.submitSectionForm = submitSectionForm;

  // ==============================================================================
  // 11. SECURITY PIN & BACKUP
  // ==============================================================================
  async function fetchBackupSummary() {
    try {
      const res = await executeRpcCall('getSystemBackupSummary', [5]);
      if (res && res.data) {
        const d = res.data;
        if (document.getElementById('backup-count-siswa')) document.getElementById('backup-count-siswa').innerText = d.siswa ?? '-';
        if (document.getElementById('backup-count-absensi')) document.getElementById('backup-count-absensi').innerText = d.absensi ?? '-';
        if (document.getElementById('backup-count-spv')) document.getElementById('backup-count-spv').innerText = d.spv ?? '-';
        if (document.getElementById('backup-count-products')) document.getElementById('backup-count-products').innerText = d.products ?? '-';
        if (document.getElementById('backup-count-machines')) document.getElementById('backup-count-machines').innerText = d.machines ?? '-';
        if (document.getElementById('backup-count-recycle')) document.getElementById('backup-count-recycle').innerText = d.recycle_bin ?? '-';
      }
    } catch (err) {
      console.warn('[fetchBackupSummary Error]:', err);
    }
  }
  window.fetchBackupSummary = fetchBackupSummary;

  async function handleUpdateMasterPin() {
    const currentPin = document.getElementById('setting-pin-current')?.value;
    const newPin = document.getElementById('setting-pin-new')?.value;
    if (!currentPin) return alert('Masukkan PIN saat ini!');
    if (!newPin || newPin.length < 6) return alert('PIN baru minimal 6 digit!');

    try {
      const res = await executeRpcCall('updateMasterPin', [currentPin, newPin, 5]);
      if (res.success) {
        showSettingToast('Master PIN berhasil diperbarui!');
        document.getElementById('setting-pin-current').value = '';
        document.getElementById('setting-pin-new').value = '';
      } else {
        showSettingToast(res.message || 'Gagal memperbarui PIN', 'error');
      }
    } catch (err) {
      showSettingToast(err.message, 'error');
    }
  }
  window.handleUpdateMasterPin = handleUpdateMasterPin;

  async function downloadCompleteBackupJson() {
    try {
      showSettingToast('Menyiapkan berkas cadangan snapshot...');
      const [settings, spv, products, sections, machines, summary] = await Promise.all([
        executeRpcCall('getSettings', [5]),
        executeRpcCall('getMasterSpvList', [5]),
        executeRpcCall('getMasterProducts', [5]),
        executeRpcCall('getMasterSections', [5]),
        executeRpcCall('getMasterMachines', [5]),
        executeRpcCall('getSystemBackupSummary', [5])
      ]);

      const backupBundle = {
        app: 'LTC Indoprima Gemilang Dashboard',
        plant: { id: 5, name: 'Plant 5 Casting' },
        exported_at: new Date().toISOString(),
        summary: summary.data,
        settings: settings.data,
        master_spv: spv.data,
        master_products: products.data,
        master_sections: sections.data,
        master_machines: machines.data
      };

      const dataStr = 'data:text/json;charset=utf-8,' + encodeURIComponent(JSON.stringify(backupBundle, null, 2));
      const dlAnchor = document.createElement('a');
      dlAnchor.setAttribute('href', dataStr);
      dlAnchor.setAttribute('download', `backup_ltc_plant5_${new Date().toISOString().slice(0, 10)}.json`);
      document.body.appendChild(dlAnchor);
      dlAnchor.click();
      dlAnchor.remove();

      showSettingToast('Snapshot JSON berhasil diunduh!');
    } catch (err) {
      showSettingToast('Gagal mengunduh backup: ' + err.message, 'error');
    }
  }
  window.downloadCompleteBackupJson = downloadCompleteBackupJson;
</script>
