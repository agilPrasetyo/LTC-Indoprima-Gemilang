  // ==============================================================================
  function calculateTotalBobot() {
    const teori = Number(document.getElementById('rc-bobot-teori')?.value || 0);
    const praktik = Number(document.getElementById('rc-bobot-praktik')?.value || 0);
    const sikap = Number(document.getElementById('rc-bobot-sikap')?.value || 0);
    const safety = Number(document.getElementById('rc-bobot-safety')?.value || 0);
    const total = teori + praktik + sikap + safety;

    const badge = document.getElementById('reportcard-total-badge');
    if (badge) {
      badge.innerText = `Total: ${total}%`;
      if (total === 100) {
        badge.className = 'px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200/60';
      } else {
        badge.className = 'px-2.5 py-1 rounded-full text-xs font-bold bg-rose-50 text-rose-700 border border-rose-200/60 animate-pulse';
      }
    }
    return total;
  }
  window.calculateTotalBobot = calculateTotalBobot;

  async function fetchReportCardConfig() {
    try {
      const res = await executeRpcCall('getReportCardConfig', [5]);
      if (res && res.data) {
        const d = res.data;
        if (document.getElementById('rc-bobot-teori')) document.getElementById('rc-bobot-teori').value = d.bobot_teori ?? 25;
        if (document.getElementById('rc-bobot-praktik')) document.getElementById('rc-bobot-praktik').value = d.bobot_praktik ?? 45;
        if (document.getElementById('rc-bobot-sikap')) document.getElementById('rc-bobot-sikap').value = d.bobot_sikap ?? 15;
        if (document.getElementById('rc-bobot-safety')) document.getElementById('rc-bobot-safety').value = d.bobot_safety_5s ?? 15;
        if (document.getElementById('rc-toggle-ranking')) document.getElementById('rc-toggle-ranking').checked = d.tampilkan_ranking !== false;
        if (document.getElementById('rc-toggle-radar')) document.getElementById('rc-toggle-radar').checked = d.tampilkan_radar !== false;
        if (document.getElementById('rc-toggle-catatan')) document.getElementById('rc-toggle-catatan').checked = d.tampilkan_catatan_spv !== false;
        if (document.getElementById('rc-grade-a')) document.getElementById('rc-grade-a').value = d.grade_a_min ?? 90;
        if (document.getElementById('rc-grade-b')) document.getElementById('rc-grade-b').value = d.grade_b_min ?? 80;
        if (document.getElementById('rc-grade-c')) document.getElementById('rc-grade-c').value = d.grade_c_min ?? 70;
        calculateTotalBobot();
