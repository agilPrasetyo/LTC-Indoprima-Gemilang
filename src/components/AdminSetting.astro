---
// src/components/AdminSetting.astro
// Desain Modern, Bersih & Minimalis (SaaS Enterprise Standard - Two-Column Layout)
---

<style>
  .setting-subtab-btn {
    transition: all 0.15s ease-in-out;
    font-size: 0.9375rem !important; /* 15px */
    line-height: 1.35rem !important;
    font-weight: 400 !important;
  }
  .setting-subtab-btn.active-subtab {
    background-color: #ffffff !important;
    color: #000000 !important;
    font-weight: 400 !important;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.15), 0 2px 4px -2px rgba(0, 0, 0, 0.1) !important;
  }
  .setting-subtab-btn.active-subtab span {
    color: #000000 !important;
    font-size: 0.9375rem !important;
    font-weight: 400 !important;
  }
  .setting-subtab-btn.active-subtab .nav-count-badge {
    background-color: #f1f5f9 !important;
    color: #000000 !important;
    font-size: 0.75rem !important;
    font-weight: 500 !important;
  }
  .setting-subtab-btn:not(.active-subtab) {
    background-color: transparent !important;
    color: #ffffff !important;
    font-weight: 400 !important;
  }
  .setting-subtab-btn:not(.active-subtab) span {
    color: #ffffff !important;
    font-size: 0.9375rem !important;
    font-weight: 400 !important;
  }
  .setting-subtab-btn:not(.active-subtab):hover {
    background-color: rgba(255, 255, 255, 0.18) !important;
    color: #ffffff !important;
  }
</style>

<div class="animate-fadeIn max-w-7xl mx-auto w-full pb-16 pt-2">

  <!-- TWO-COLUMN LAYOUT (SEJAJAR HORIZONTAL) -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">

    <!-- SISI KIRI: SIDEBAR KATEGORI & MENU SETTINGS (BLUE INDOPRIMA THEME) -->
    <aside class="lg:col-span-3 space-y-3">
      <div class="bg-blue-600 rounded-2xl border border-blue-700 p-4 shadow-xl shadow-blue-700/20 space-y-4 sticky top-4">

        <!-- GRUP 1: AKADEMIK & PENILAIAN -->
        <div class="space-y-1">
          <div class="px-2.5 py-1 text-xs font-semibold uppercase tracking-wider text-blue-100/90">
            Akademik & Penilaian
          </div>
          <div class="space-y-1">
            <button onclick="switchSettingSubTab('kelulusan')" id="setting-nav-kelulusan"
              style="background-color: #ffffff !important; color: #000000 !important;"
              class="setting-subtab-btn active-subtab w-full text-left px-4 py-3 rounded-xl text-sm font-normal flex items-center justify-between transition-all cursor-pointer shadow-md">
              <span style="color: #000000 !important;">Aturan Kelulusan & KKM</span>
            </button>

            <button onclick="switchSettingSubTab('reportcard')" id="setting-nav-reportcard"
              class="setting-subtab-btn w-full text-left px-4 py-3 rounded-xl text-sm font-normal text-white hover:bg-white/15 flex items-center justify-between transition-all cursor-pointer">
              <span>Komponen Report Card</span>
            </button>

            <button onclick="switchSettingSubTab('sertifikat')" id="setting-nav-sertifikat"
              class="setting-subtab-btn w-full text-left px-4 py-3 rounded-xl text-sm font-normal text-white hover:bg-white/15 flex items-center justify-between transition-all cursor-pointer">
              <span>Template Sertifikat</span>
            </button>

            <button onclick="switchSettingSubTab('batch')" id="setting-nav-batch"
              class="setting-subtab-btn w-full text-left px-4 py-3 rounded-xl text-sm font-normal text-white hover:bg-white/15 flex items-center justify-between transition-all cursor-pointer">
              <span>Batch & Angkatan</span>
            </button>
          </div>
        </div>

        <!-- GRUP 2: MASTER OPERASIONAL -->
        <div class="space-y-1 pt-3 border-t border-white/20">
          <div class="px-2.5 py-1 text-xs font-semibold uppercase tracking-wider text-blue-100/90">
            Master Operasional
          </div>
          <div class="space-y-1">
            <button onclick="switchSettingSubTab('machines')" id="setting-nav-machines"
              class="setting-subtab-btn w-full text-left px-4 py-3 rounded-xl text-sm font-normal text-white hover:bg-white/15 flex items-center justify-between transition-all cursor-pointer">
              <span>Daftar Mesin</span>
              <span id="nav-machines-count" class="nav-count-badge px-2.5 py-0.5 rounded-full text-xs font-medium bg-white/20 text-white">0</span>
            </button>

            <button onclick="switchSettingSubTab('products')" id="setting-nav-products"
              class="setting-subtab-btn w-full text-left px-4 py-3 rounded-xl text-sm font-normal text-white hover:bg-white/15 flex items-center justify-between transition-all cursor-pointer">
              <span>Produk & Target</span>
              <span id="nav-products-count" class="nav-count-badge px-2.5 py-0.5 rounded-full text-xs font-medium bg-white/20 text-white">0</span>
            </button>

            <button onclick="switchSettingSubTab('spv')" id="setting-nav-spv"
              class="setting-subtab-btn w-full text-left px-4 py-3 rounded-xl text-sm font-normal text-white hover:bg-white/15 flex items-center justify-between transition-all cursor-pointer">
              <span>Daftar SPV</span>
              <span id="nav-spv-count" class="nav-count-badge px-2.5 py-0.5 rounded-full text-xs font-medium bg-white/20 text-white">0</span>
            </button>

            <button onclick="switchSettingSubTab('sections')" id="setting-nav-sections"
              class="setting-subtab-btn w-full text-left px-4 py-3 rounded-xl text-sm font-normal text-white hover:bg-white/15 flex items-center justify-between transition-all cursor-pointer">
              <span>Daftar Section</span>
              <span id="nav-sections-count" class="nav-count-badge px-2.5 py-0.5 rounded-full text-xs font-medium bg-white/20 text-white">0</span>
            </button>
          </div>
        </div>

        <!-- GRUP 3: TATA KELOLA & AUDIT -->
        <div class="space-y-1 pt-3 border-t border-white/20">
          <div class="px-2.5 py-1 text-xs font-semibold uppercase tracking-wider text-blue-100/90">
            Tata Kelola & Audit
          </div>
          <div class="space-y-1">
            <button onclick="switchSettingSubTab('logs')" id="setting-nav-logs"
              class="setting-subtab-btn w-full text-left px-4 py-3 rounded-xl text-sm font-normal text-white hover:bg-white/15 flex items-center justify-between transition-all cursor-pointer">
              <span>Log Aktivitas Admin</span>
            </button>

            <button onclick="switchSettingSubTab('recycle')" id="setting-nav-recycle"
              class="setting-subtab-btn w-full text-left px-4 py-3 rounded-xl text-sm font-normal text-white hover:bg-white/15 flex items-center justify-between transition-all cursor-pointer">
              <span>Recycle Bin</span>
              <span id="nav-recycle-badge" class="nav-count-badge badge-recycle px-2.5 py-0.5 rounded-full text-xs font-medium bg-rose-500 text-white">0</span>
            </button>
          </div>
        </div>

        <!-- GRUP 4: KEAMANAN & SISTEM -->
        <div class="space-y-1 pt-3 border-t border-white/20">
          <div class="px-2.5 py-1 text-xs font-semibold uppercase tracking-wider text-blue-100/90">
            Keamanan & Sistem
          </div>
          <div class="space-y-1">
            <button onclick="switchSettingSubTab('pin')" id="setting-nav-pin"
              class="setting-subtab-btn w-full text-left px-4 py-3 rounded-xl text-sm font-normal text-white hover:bg-white/15 flex items-center justify-between transition-all cursor-pointer">
              <span>Master Security PIN</span>
            </button>

            <button onclick="switchSettingSubTab('backup')" id="setting-nav-backup"
              class="setting-subtab-btn w-full text-left px-4 py-3 rounded-xl text-sm font-normal text-white hover:bg-white/15 flex items-center justify-between transition-all cursor-pointer">
              <span>Backup & Snapshot</span>
            </button>
          </div>
        </div>

      </div>
    </aside>

    <!-- SISI KANAN: KONTEN PANEL AKTIF (lg:col-span-9) -->
    <main class="lg:col-span-9 space-y-6">

      <!-- ====================================================================
           PANEL 1: ATURAN KELULUSAN & KKM
           ==================================================================== -->
      <div id="setting-panel-kelulusan" class="setting-panel space-y-6 animate-fadeIn">
        <div class="bg-white rounded-2xl border border-slate-200/70 p-6 shadow-2xs space-y-6">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-100 pb-4">
            <div>
              <h3 class="text-base font-bold text-slate-900">Aturan Kelulusan & Standar KKM</h3>
            </div>
            <button onclick="saveGraduationRulesForm()"
              class="px-4 py-2 bg-blue-600 hover:bg-blue-700 active:scale-98 text-white font-medium rounded-xl text-xs flex items-center justify-center gap-2 transition-all shadow-xs cursor-pointer self-start sm:self-auto">
              <i class="fa-solid fa-check"></i> Simpan Aturan Kelulusan
            </button>
          </div>

          <!-- Grid Standar Nilai KKM -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <!-- Teori -->
            <div class="p-4 rounded-xl border border-slate-200/70 bg-slate-50/40 hover:bg-white transition-all space-y-2">
              <div class="flex items-center justify-between text-slate-600">
                <span class="text-xs font-semibold">KKM Teori</span>
                <i class="fa-solid fa-book-open text-slate-400 text-xs"></i>
              </div>
              <div class="flex items-center gap-2">
                <input type="number" id="rule-kkm-teori" min="0" max="100"
                  class="w-full px-3 py-2 bg-white border border-slate-200 rounded-lg text-sm font-bold text-slate-900 outline-none focus:border-blue-600 focus:ring-2 focus:ring-blue-100">
                <span class="text-xs text-slate-400 font-medium">poin</span>
              </div>
            </div>

            <!-- Praktik -->
            <div class="p-4 rounded-xl border border-slate-200/70 bg-slate-50/40 hover:bg-white transition-all space-y-2">
              <div class="flex items-center justify-between text-slate-600">
                <span class="text-xs font-semibold">KKM Praktik</span>
                <i class="fa-solid fa-wrench text-slate-400 text-xs"></i>
              </div>
              <div class="flex items-center gap-2">
                <input type="number" id="rule-kkm-praktik" min="0" max="100"
                  class="w-full px-3 py-2 bg-white border border-slate-200 rounded-lg text-sm font-bold text-slate-900 outline-none focus:border-blue-600 focus:ring-2 focus:ring-blue-100">
                <span class="text-xs text-slate-400 font-medium">poin</span>
              </div>
            </div>

            <!-- Sikap -->
            <div class="p-4 rounded-xl border border-slate-200/70 bg-slate-50/40 hover:bg-white transition-all space-y-2">
              <div class="flex items-center justify-between text-slate-600">
                <span class="text-xs font-semibold">KKM Sikap</span>
                <i class="fa-solid fa-shield-halved text-slate-400 text-xs"></i>
              </div>
              <div class="flex items-center gap-2">
                <input type="number" id="rule-kkm-sikap" min="0" max="100"
                  class="w-full px-3 py-2 bg-white border border-slate-200 rounded-lg text-sm font-bold text-slate-900 outline-none focus:border-blue-600 focus:ring-2 focus:ring-blue-100">
                <span class="text-xs text-slate-400 font-medium">poin</span>
              </div>
            </div>

            <!-- Min Kehadiran -->
            <div class="p-4 rounded-xl border border-slate-200/70 bg-slate-50/40 hover:bg-white transition-all space-y-2">
              <div class="flex items-center justify-between text-slate-600">
                <span class="text-xs font-semibold">Min. Kehadiran</span>
                <i class="fa-solid fa-calendar-check text-slate-400 text-xs"></i>
              </div>
              <div class="flex items-center gap-2">
                <input type="number" id="rule-min-absensi" min="0" max="100" step="0.5"
                  class="w-full px-3 py-2 bg-white border border-slate-200 rounded-lg text-sm font-bold text-slate-900 outline-none focus:border-blue-600 focus:ring-2 focus:ring-blue-100">
                <span class="text-xs text-slate-400 font-medium">%</span>
              </div>
            </div>
          </div>

          <!-- Parameter Tambahan -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2">
            <div class="space-y-1.5">
              <label class="block text-xs font-semibold text-slate-700">Maksimal Toleransi Alpa / Tanpa Keterangan</label>
              <div class="flex items-center gap-2">
                <input type="number" id="rule-max-alpa" min="0" max="10"
                  class="w-full px-3.5 py-2.5 bg-slate-50/50 hover:bg-white focus:bg-white border border-slate-200 rounded-xl text-xs font-semibold text-slate-800 outline-none focus:border-blue-600 focus:ring-2 focus:ring-blue-100 transition-all">
                <span class="text-xs text-slate-500 font-medium">hari</span>
              </div>
            </div>

            <div class="space-y-1.5">
              <label class="block text-xs font-semibold text-slate-700">Mekanisme Penentuan Kelulusan</label>
              <select id="rule-evaluasi-mode"
                class="w-full px-3.5 py-2.5 bg-slate-50/50 hover:bg-white focus:bg-white border border-slate-200 rounded-xl text-xs font-semibold text-slate-800 outline-none focus:border-blue-600 focus:ring-2 focus:ring-blue-100 transition-all cursor-pointer">
                <option value="AUTOMATIC">Otomatis Lulus jika semua parameter >= KKM</option>
                <option value="NEED_SPV_REVIEW">Verifikasi Manual / Butuh Review Instruktur SPV</option>
              </select>
            </div>
          </div>

          <!-- Catatan / Klausul Kelulusan -->
          <div class="space-y-1.5">
            <label class="block text-xs font-semibold text-slate-700">Klausul Keterangan Kelulusan (Tercetak di Rapor)</label>
            <textarea id="rule-catatan" rows="3" placeholder="Siswa dinyatakan Lulus bila seluruh nilai memenuhi KKM..."
              class="w-full p-3.5 bg-slate-50/50 hover:bg-white focus:bg-white border border-slate-200 rounded-xl text-xs text-slate-800 outline-none focus:border-blue-600 focus:ring-2 focus:ring-blue-100 transition-all resize-none"></textarea>
          </div>
        </div>
      </div>

      <!-- ====================================================================
           PANEL 2: KONFIGURASI KOMPONEN REPORT CARD
           ==================================================================== -->
      <div id="setting-panel-reportcard" class="setting-panel hidden space-y-6 animate-fadeIn">
        <div class="bg-white rounded-2xl border border-slate-200/70 p-6 shadow-2xs space-y-6">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-100 pb-4">
            <div class="flex items-center gap-3">
              <h3 class="text-base font-bold text-slate-900">Bobot Komponen Penilaian Report Card</h3>
              <span id="reportcard-total-badge" class="px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200/60">
                Total: 100%
              </span>
            </div>
            <button onclick="saveReportCardConfigForm()"
              class="px-4 py-2 bg-blue-600 hover:bg-blue-700 active:scale-98 text-white font-medium rounded-xl text-xs flex items-center justify-center gap-2 transition-all shadow-xs cursor-pointer self-start sm:self-auto">
              <i class="fa-solid fa-check"></i> Simpan Bobot Rapor
            </button>
          </div>

          <!-- Bobot Persentase 4 Aspek -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="p-4 rounded-xl border border-slate-200/70 bg-slate-50/40 space-y-2">
              <label class="block text-xs font-semibold text-slate-700">Teori Dasar & Kejuruan</label>
              <div class="flex items-center gap-2">
                <input type="number" id="rc-bobot-teori" min="0" max="100" oninput="calculateTotalBobot()"
                  class="w-full px-3 py-2 bg-white border border-slate-200 rounded-lg text-sm font-bold text-slate-900 outline-none focus:border-blue-600 focus:ring-2 focus:ring-blue-100">
                <span class="text-xs text-slate-400 font-medium">%</span>
              </div>
            </div>

            <div class="p-4 rounded-xl border border-slate-200/70 bg-slate-50/40 space-y-2">
              <label class="block text-xs font-semibold text-slate-700">Praktik Kerja / Kinerja</label>
              <div class="flex items-center gap-2">
                <input type="number" id="rc-bobot-praktik" min="0" max="100" oninput="calculateTotalBobot()"
                  class="w-full px-3 py-2 bg-white border border-slate-200 rounded-lg text-sm font-bold text-slate-900 outline-none focus:border-blue-600 focus:ring-2 focus:ring-blue-100">
                <span class="text-xs text-slate-400 font-medium">%</span>
              </div>
            </div>

            <div class="p-4 rounded-xl border border-slate-200/70 bg-slate-50/40 space-y-2">
              <label class="block text-xs font-semibold text-slate-700">Sikap & Kedisiplinan</label>
              <div class="flex items-center gap-2">
                <input type="number" id="rc-bobot-sikap" min="0" max="100" oninput="calculateTotalBobot()"
                  class="w-full px-3 py-2 bg-white border border-slate-200 rounded-lg text-sm font-bold text-slate-900 outline-none focus:border-blue-600 focus:ring-2 focus:ring-blue-100">
                <span class="text-xs text-slate-400 font-medium">%</span>
              </div>
            </div>

            <div class="p-4 rounded-xl border border-slate-200/70 bg-slate-50/40 space-y-2">
              <label class="block text-xs font-semibold text-slate-700">Safety, 5S & K3</label>
              <div class="flex items-center gap-2">
                <input type="number" id="rc-bobot-safety" min="0" max="100" oninput="calculateTotalBobot()"
                  class="w-full px-3 py-2 bg-white border border-slate-200 rounded-lg text-sm font-bold text-slate-900 outline-none focus:border-blue-600 focus:ring-2 focus:ring-blue-100">
                <span class="text-xs text-slate-400 font-medium">%</span>
              </div>
            </div>
          </div>

          <!-- Opsi Tampilan di Rapor Siswa -->
          <div class="border-t border-slate-100 pt-5 space-y-3">
            <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400">Komponen Tampilan Cetak</h4>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <label class="flex items-center justify-between p-3.5 rounded-xl border border-slate-200/80 bg-slate-50/40 cursor-pointer hover:bg-white transition-all">
                <span class="text-xs font-semibold text-slate-800">Peringkat / Ranking</span>
                <input type="checkbox" id="rc-toggle-ranking" class="rounded text-blue-600 focus:ring-blue-500 w-4 h-4 cursor-pointer">
              </label>

              <label class="flex items-center justify-between p-3.5 rounded-xl border border-slate-200/80 bg-slate-50/40 cursor-pointer hover:bg-white transition-all">
                <span class="text-xs font-semibold text-slate-800">Grafik Radar Skill</span>
                <input type="checkbox" id="rc-toggle-radar" class="rounded text-blue-600 focus:ring-blue-500 w-4 h-4 cursor-pointer">
              </label>

              <label class="flex items-center justify-between p-3.5 rounded-xl border border-slate-200/80 bg-slate-50/40 cursor-pointer hover:bg-white transition-all">
                <span class="text-xs font-semibold text-slate-800">Catatan Khusus SPV</span>
                <input type="checkbox" id="rc-toggle-catatan" class="rounded text-blue-600 focus:ring-blue-500 w-4 h-4 cursor-pointer">
              </label>
            </div>
          </div>

          <!-- Batas Rentang Predikat -->
          <div class="border-t border-slate-100 pt-5 space-y-3">
            <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400">Standar Predikat Nilai</h4>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <div class="space-y-1.5">
                <label class="block text-xs font-semibold text-slate-700">Ambang Predikat A (Sangat Baik)</label>
                <div class="flex items-center gap-2">
                  <input type="number" id="rc-grade-a" min="0" max="100"
                    class="w-full px-3 py-2 bg-white border border-slate-200 rounded-lg text-xs font-semibold text-slate-900 outline-none focus:border-blue-600">
                  <span class="text-xs text-slate-400 font-medium">ke atas</span>
                </div>
              </div>

              <div class="space-y-1.5">
                <label class="block text-xs font-semibold text-slate-700">Ambang Predikat B (Baik / Kompeten)</label>
                <div class="flex items-center gap-2">
                  <input type="number" id="rc-grade-b" min="0" max="100"
                    class="w-full px-3 py-2 bg-white border border-slate-200 rounded-lg text-xs font-semibold text-slate-900 outline-none focus:border-blue-600">
                  <span class="text-xs text-slate-400 font-medium">ke atas</span>
                </div>
              </div>

              <div class="space-y-1.5">
                <label class="block text-xs font-semibold text-slate-700">Ambang Predikat C (Cukup / Butuh Bimbingan)</label>
                <div class="flex items-center gap-2">
                  <input type="number" id="rc-grade-c" min="0" max="100"
                    class="w-full px-3 py-2 bg-white border border-slate-200 rounded-lg text-xs font-semibold text-slate-900 outline-none focus:border-blue-600">
                  <span class="text-xs text-slate-400 font-medium">ke atas</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- ====================================================================
           PANEL 3: TEMPLATE SERTIFIKAT
           ==================================================================== -->
      <div id="setting-panel-sertifikat" class="setting-panel hidden space-y-6 animate-fadeIn">
        <div class="bg-white rounded-2xl border border-slate-200/70 p-6 shadow-2xs space-y-6">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-100 pb-4">
            <div>
              <h3 class="text-base font-bold text-slate-900">Konfigurasi Template Sertifikat Kelulusan</h3>
            </div>
            <button onclick="saveCertificateConfigForm()"
              class="px-4 py-2 bg-blue-600 hover:bg-blue-700 active:scale-98 text-white font-medium rounded-xl text-xs flex items-center justify-center gap-2 transition-all shadow-xs cursor-pointer self-start sm:self-auto">
              <i class="fa-solid fa-check"></i> Simpan Template
            </button>
          </div>

          <!-- Format Nomor Sertifikat -->
          <div class="p-4 bg-slate-50/60 rounded-xl border border-slate-200/70 space-y-2">
            <label class="block text-xs font-semibold text-slate-800">Format Template Nomor Sertifikat</label>
            <input type="text" id="cert-nomor-format" oninput="updateCertPreview()" placeholder="LTC/P5/{YYYY}/{BATCH}/{NO}"
              class="w-full px-3.5 py-2.5 bg-white border border-slate-200 rounded-xl text-xs font-mono font-semibold text-slate-900 outline-none focus:border-blue-600 focus:ring-2 focus:ring-blue-100">
            <div class="flex items-center gap-2 text-[11px] text-slate-500 pt-1">
              <span>Contoh hasil nomor terbit:</span>
              <span id="cert-nomor-preview" class="font-mono font-bold text-blue-700 bg-blue-50 px-2 py-0.5 rounded border border-blue-200/60">
                LTC/P5/2026/BATCH-A/001
              </span>
            </div>
          </div>

          <!-- Data Penandatangan -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Penandatangan 1 -->
            <div class="p-4 rounded-xl border border-slate-200/70 space-y-3">
              <div class="flex items-center gap-2 text-xs font-bold text-slate-800 border-b border-slate-100 pb-2">
