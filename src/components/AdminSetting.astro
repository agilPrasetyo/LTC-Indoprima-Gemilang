<!-- Toast Container -->
<div id="setting-toast-container" class="fixed bottom-6 right-6 z-50 space-y-2 pointer-events-none"></div>

<script is:inline>
  // Helper Toast Feedback
  function showSettingToast(msg, type = 'success') {
    let container = document.getElementById('setting-toast-container');
    if (!container) {
      container = document.createElement('div');
      container.id = 'setting-toast-container';
      container.className = 'fixed bottom-6 right-6 z-50 space-y-2 pointer-events-none';
      document.body.appendChild(container);
    }
    const toast = document.createElement('div');
    toast.className = `p-3 px-4 rounded-xl shadow-lg border text-xs font-semibold flex items-center gap-2.5 transition-all duration-300 animate-slideIn pointer-events-auto ${
      type === 'success' ? 'bg-slate-900 text-white border-slate-800' : 'bg-rose-600 text-white border-rose-500'
    }`;
    toast.innerHTML = `<i class="fa-solid ${type === 'success' ? 'fa-circle-check text-emerald-400' : 'fa-circle-exclamation text-white'} text-sm"></i> <span>${msg}</span>`;
    container.appendChild(toast);
    setTimeout(() => {
      toast.classList.add('opacity-0', 'translate-y-2');
      setTimeout(() => toast.remove(), 300);
    }, 3200);
  }

  // Helper RPC Call
  async function executeRpcCall(action, args = []) {
    const res = await fetch('/api/rpc', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ action, args })
    });
    if (!res.ok) {
      const err = await res.json().catch(() => ({}));
      throw new Error(err.message || `RPC Error HTTP ${res.status}`);
    }
    return await res.json();
  }

  // Switch Sub-Tab Logic (Two-Column Navigation - Royal Blue Container, Pure Solid White #ffffff Active Button)
  function switchSettingSubTab(tab) {
    document.querySelectorAll('.setting-subtab-btn').forEach(btn => {
      btn.classList.remove('active-subtab');
      btn.style.setProperty('background-color', 'transparent', 'important');
      btn.style.setProperty('color', '#ffffff', 'important');
      btn.style.fontWeight = '400';
      const span = btn.querySelector('span');
      if (span) {
        span.style.setProperty('color', '#ffffff', 'important');
        span.style.fontWeight = '400';
      }
      const badge = btn.querySelector('.nav-count-badge');
      if (badge && !badge.classList.contains('badge-recycle')) {
        badge.style.setProperty('background-color', 'rgba(255, 255, 255, 0.2)', 'important');
        badge.style.setProperty('color', '#ffffff', 'important');
      }
    });

    const activeBtn = document.getElementById('setting-nav-' + tab);
    if (activeBtn) {
      activeBtn.classList.add('active-subtab');
      activeBtn.style.setProperty('background-color', '#ffffff', 'important');
      activeBtn.style.setProperty('color', '#000000', 'important');
      activeBtn.style.fontWeight = '400';
      const span = activeBtn.querySelector('span');
      if (span) {
        span.style.setProperty('color', '#000000', 'important');
        span.style.fontWeight = '400';
      }
      const badge = activeBtn.querySelector('.nav-count-badge');
      if (badge && !badge.classList.contains('badge-recycle')) {
        badge.style.setProperty('background-color', '#f1f5f9', 'important');
        badge.style.setProperty('color', '#000000', 'important');
      }
    }

    document.querySelectorAll('.setting-panel').forEach(panel => panel.classList.add('hidden'));
    const activePanel = document.getElementById('setting-panel-' + tab);
    if (activePanel) activePanel.classList.remove('hidden');

    // Trigger data fetching for respective tab
    if (tab === 'kelulusan') fetchGraduationRules();
    if (tab === 'reportcard') fetchReportCardConfig();
    if (tab === 'sertifikat') fetchCertificateConfig();
    if (tab === 'batch') fetchBatchSettings();
    if (tab === 'machines') fetchMachineList();
    if (tab === 'products') fetchProductList();
    if (tab === 'spv') fetchSpvList();
    if (tab === 'sections') fetchSectionList();
    if (tab === 'logs') fetchActivityLogs();
    if (tab === 'recycle') fetchRecycleBinItems();
    if (tab === 'backup') fetchBackupSummary();
  }
