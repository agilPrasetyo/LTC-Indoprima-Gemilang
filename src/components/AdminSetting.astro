        tampilkan_catatan_spv: document.getElementById('rc-toggle-catatan')?.checked ?? true,
        grade_a_min: Number(document.getElementById('rc-grade-a')?.value || 90),
        grade_b_min: Number(document.getElementById('rc-grade-b')?.value || 80),
