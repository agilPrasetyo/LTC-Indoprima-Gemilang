  function updateSectionDropdowns() {
    const dropdownIds = ['form-machine-section', 'form-spv-section', 'form-product-section'];
    dropdownIds.forEach(id => {
      const el = document.getElementById(id);
      if (!el) return;
      const current = el.value;
      let opts = '<option value="">-- Pilih Section --</option>';
      (sectionCache || []).forEach(sec => {
        opts += `<option value="${sec.nama_section}">${sec.nama_section} (${sec.departemen || 'Produksi'})</option>`;
      });
      el.innerHTML = opts;
      if (current) el.value = current;
    });
  }

