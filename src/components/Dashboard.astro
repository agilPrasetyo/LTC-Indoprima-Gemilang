<!-- BARIS 3: GRAFIK PERFORMA LTC & TURNOVER (BATANG) -->
<!-- ============================================================ -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mt-6 animate-fadeIn">
    <!-- Grafik Performa LTC -->
    <div class="bg-white p-6 rounded-[24px] border border-slate-100 shadow-sm space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-100 pb-4">
            <div>
                <h3 class="font-display font-bold text-lg text-brand-textMain">Grafik Performa LTC</h3>
            </div>
            <div>
                <select id="class-chart-filter" onchange="updateLtcChart()"
                    class="w-full sm:w-auto px-3.5 py-1.5 border border-slate-200 rounded-xl text-xs outline-none focus:border-brand-blue bg-white text-brand-textSub font-bold shadow-sm">
                    <option value="all">Rata-rata Kelas (Semua)</option>
                    <option value="Kelas 1">Kelas 1</option>
                    <option value="Kelas 2">Kelas 2</option>
                    <option value="Kelas 3">Kelas 3</option>
                    <option value="Kelas 4">Kelas 4</option>
                    <option value="Kelas 5">Kelas 5</option>
                </select>
            </div>
        </div>

        <!-- Rentang Tanggal Khusus Grafik -->
        <div class="flex flex-wrap items-center gap-2 bg-slate-50 p-2.5 rounded-2xl text-xs">
            <span class="font-semibold text-slate-600"><i class="fa-regular fa-calendar text-brand-blue mr-1"></i> Filter:</span>
            <div class="flex items-center gap-1">
                <input type="date" id="chart-start-date" onchange="updateLtcChart()" class="px-2 py-1 border border-slate-200 rounded-lg outline-none focus:border-brand-blue bg-white text-slate-700 text-[11px]">
            </div>
            <span class="text-slate-400">s/d</span>
            <div class="flex items-center gap-1">
                <input type="date" id="chart-end-date" onchange="updateLtcChart()" class="px-2 py-1 border border-slate-200 rounded-lg outline-none focus:border-brand-blue bg-white text-slate-700 text-[11px]">
            </div>
            <button onclick="resetChartLocalDates()" class="px-2.5 py-1 bg-white hover:bg-slate-100 border border-slate-200 text-slate-600 rounded-lg font-bold transition-all-300 ml-auto text-[11px]">
                Reset
            </button>
        </div>

        <div class="relative h-72">
            <canvas id="ltcPerformanceChart"></canvas>
        </div>
    </div>

    <!-- Grafik Turnover (Statistik Turnover & Kelulusan) -->
    <div class="bg-white p-6 rounded-[24px] border border-slate-100 shadow-sm flex flex-col justify-between group">
        <div>
            <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                <div class="flex items-center gap-2">
                    <span class="p-2 rounded-lg bg-indigo-50 text-indigo-600 text-xs"><i class="fa-solid fa-users-rays"></i></span>
                    <h3 class="font-display font-bold text-lg text-brand-textMain">Statistik Turnover</h3>
                </div>
                <div class="flex items-center gap-2">
                    <select id="dash-turnover-month-filter" onchange="onDashTurnoverMonthChanged()"
                        class="px-2.5 py-1 bg-slate-50 border border-slate-200 rounded-xl text-[11px] font-bold text-brand-textMain outline-none focus:border-brand-blue transition-all cursor-pointer">
                        <option value="ALL">Semua Bulan</option>
                    </select>
                    <span class="px-3 py-1 bg-slate-100 text-slate-700 rounded-full text-[11px] font-bold font-mono" id="stat-turnover-total-badge">0 Siswa</span>
                </div>
            </div>
            
            <!-- Modern Donut Chart + Clean Interactive Legend -->
            <div class="flex flex-col sm:flex-row items-center gap-5 mt-4">
                <!-- Donut Canvas Container -->
                <div class="relative w-full sm:w-[50%] h-48 flex items-center justify-center">
                    <canvas id="dashboardTurnoverPieChart"></canvas>
                    <!-- Clean Floating Center Typography -->
                    <div class="absolute inset-0 flex flex-col items-center justify-center pointer-events-none text-center">
                        <span id="dashboard-turnover-total-center" class="text-3xl font-display font-black text-slate-800 leading-none tracking-tight">0%</span>
                        <span class="text-[9px] font-extrabold uppercase tracking-widest text-slate-400 mt-1">Rasio Turnover</span>
                    </div>
                </div>

                <!-- Right Legend Cards -->
                <div class="w-full sm:w-[50%] flex flex-col gap-2">
                    <!-- Resign -->
                    <div class="p-2.5 rounded-xl bg-amber-50/70 border border-amber-100/80 flex items-center justify-between transition-all hover:bg-amber-50">
                        <div class="flex items-center gap-2">
                            <span class="w-2.5 h-2.5 rounded-full bg-amber-500 shadow-xs"></span>
                            <div>
                                <p class="text-xs font-bold text-amber-950 leading-tight">Resign Mandiri</p>
                                <p class="text-[9px] text-amber-600/90 font-medium leading-none mt-0.5">Alasan Pribadi</p>
                            </div>
                        </div>
                        <div class="text-right">
                            <span class="text-xs font-extrabold text-amber-700 font-mono" id="stat-turnover-resign-val">0 Siswa</span>
                            <span class="text-[10px] text-amber-600 font-bold block" id="stat-turnover-resign-pct">0%</span>
                        </div>
                    </div>

                    <!-- Indisipliner -->
                    <div class="p-2.5 rounded-xl bg-rose-50/70 border border-rose-100/80 flex items-center justify-between transition-all hover:bg-rose-50">
                        <div class="flex items-center gap-2">
                            <span class="w-2.5 h-2.5 rounded-full bg-rose-500 shadow-xs"></span>
                            <div>
                                <p class="text-xs font-bold text-rose-950 leading-tight">Indisipliner</p>
                                <p class="text-[9px] text-rose-600/90 font-medium leading-none mt-0.5">Evaluasi Ketertiban</p>
                            </div>
                        </div>
                        <div class="text-right">
                            <span class="text-xs font-extrabold text-rose-700 font-mono" id="stat-turnover-indisipliner-val">0 Siswa</span>
                            <span class="text-[10px] text-rose-600 font-bold block" id="stat-turnover-indis-pct">0%</span>
                        </div>
                    </div>

                    <!-- Siswa Aktif Terkini -->
                    <div class="p-2.5 rounded-xl bg-blue-50/70 border border-blue-100/80 flex items-center justify-between transition-all hover:bg-blue-50">
                        <div class="flex items-center gap-2">
                            <span class="w-2.5 h-2.5 rounded-full bg-blue-500 shadow-xs"></span>
                            <div>
                                <p class="text-xs font-bold text-blue-950 leading-tight">Siswa Aktif Terkini</p>
                                <p class="text-[9px] text-blue-600/90 font-medium leading-none mt-0.5">Basis Populasi</p>
                            </div>
                        </div>
                        <div class="text-right">
                            <span class="text-xs font-extrabold text-blue-700 font-mono" id="stat-turnover-lulus-val">0 Siswa</span>
                            <span class="text-[10px] text-blue-600 font-bold block" id="stat-turnover-lulus-pct">Basis 100%</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Mini Metrics Row (Pengisi Space Bawah) -->
            <div class="pt-3.5 mt-3.5 border-t border-slate-100 grid grid-cols-3 gap-2">
                <!-- Mini Metric 1: Total Kasus Turnover -->
                <div class="bg-amber-50/70 border border-amber-100/80 rounded-2xl p-2.5 flex flex-col justify-between transition-all hover:bg-amber-50">
                    <div class="flex items-center gap-1.5 text-amber-700">
                        <span class="p-1 rounded-md bg-amber-100/80 text-[10px]"><i class="fa-solid fa-person-walking-arrow-right"></i></span>
                        <span class="text-[9px] font-extrabold uppercase tracking-wider text-amber-800 truncate">Total Kasus</span>
                    </div>
                    <p id="stat-turnover-lulus-rate" class="text-base sm:text-lg font-black text-amber-700 mt-2">0 Siswa</p>
                    <span class="text-[8px] font-bold text-amber-600/90 mt-0.5 truncate">Resign + Indisiplin</span>
                </div>

                <!-- Mini Metric 2: Rasio Turnover -->
                <div class="bg-rose-50/70 border border-rose-100/80 rounded-2xl p-2.5 flex flex-col justify-between transition-all hover:bg-rose-50">
                    <div class="flex items-center gap-1.5 text-rose-700">
                        <span class="p-1 rounded-md bg-rose-100/80 text-[10px]"><i class="fa-solid fa-triangle-exclamation"></i></span>
                        <span class="text-[9px] font-extrabold uppercase tracking-wider text-rose-800 truncate">Rasio Turnover</span>
                    </div>
                    <p id="stat-turnover-eval-rate" class="text-base sm:text-lg font-black text-rose-700 mt-2">0%</p>
                    <span class="text-[8px] font-bold text-rose-600/90 mt-0.5 truncate">(Resign + Indis) / Siswa</span>
                </div>

                <!-- Mini Metric 3: Turnover Bulan Ini -->
                <div class="bg-sky-50/70 border border-sky-100/80 rounded-2xl p-2.5 flex flex-col justify-between transition-all hover:bg-sky-50">
                    <div class="flex items-center gap-1.5 text-sky-700">
                        <span class="p-1 rounded-md bg-sky-100/80 text-[10px]"><i class="fa-solid fa-calendar-day"></i></span>
                        <span class="text-[9px] font-extrabold uppercase tracking-wider text-sky-800 truncate">Bulan Ini</span>
                    </div>
                    <p id="stat-turnover-month-count" class="text-base sm:text-lg font-black text-sky-700 mt-2">0 Siswa</p>
                    <span id="stat-turnover-month-label" class="text-[8px] font-bold text-sky-600/90 mt-0.5 truncate">September 2026</span>
                </div>
            </div>
