<div class="grid grid-cols-3 gap-2 sm:gap-4 md:gap-6 animate-fadeIn">
    <!-- Card 1: Siswa Aktif -->
    <div class="bg-white p-3 sm:p-5 md:p-6 rounded-2xl sm:rounded-[24px] border border-slate-100 shadow-sm flex flex-col justify-between cursor-pointer hover:-translate-y-1.5 hover:shadow-lg hover:border-teal-200 active:scale-[0.97] transition-all duration-300 ease-out group" onclick="switchView('siswa')" title="Klik untuk lihat daftar siswa aktif">
        <div>
            <div class="flex items-center gap-1.5 sm:gap-2">
                <span class="p-1.5 sm:p-2 rounded-lg bg-teal-50 text-brand-teal text-[10px] sm:text-xs group-hover:bg-teal-100 transition-colors"><i class="fa-solid fa-user-check"></i></span>
                <span class="text-[9px] sm:text-xs font-bold uppercase tracking-wider text-brand-textSub truncate">Siswa Aktif</span>
            </div>
            <p class="text-lg sm:text-3xl md:text-4xl font-bold font-display text-brand-textMain mt-2 sm:mt-4" id="stat-siswa-aktif">0</p>
