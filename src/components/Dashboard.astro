                <span class="p-1 sm:p-1.5 rounded-lg bg-teal-50 text-brand-teal text-[10px] sm:text-xs group-hover:bg-teal-100 transition-colors"><i class="fa-solid fa-user-check"></i></span>
                <span class="text-[9px] sm:text-xs font-bold uppercase tracking-wider text-brand-textSub truncate">Siswa Aktif</span>
