                <span class="text-[9px] sm:text-xs font-bold uppercase tracking-wider text-brand-textSub truncate">Persentase LTC</span>
            </div>
            <p class="text-base sm:text-2xl md:text-3xl font-bold font-display text-brand-textMain mt-1 sm:mt-2" id="stat-persentase-ltc">0%</p>
        </div>
        <div class="flex items-center justify-between mt-1.5 sm:mt-2">
            <span id="populasi-tanggal-indicator" class="inline-flex items-center gap-1 px-1.5 sm:px-2 py-0.5 bg-indigo-50 text-indigo-600 rounded-md sm:rounded-lg text-[8px] sm:text-[10px] font-semibold">
