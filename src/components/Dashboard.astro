            <div class="text-teal-400 group-hover:text-teal-600 transition-colors hidden sm:block">
                <i class="fa-solid fa-arrow-right text-xs sm:text-sm"></i>
            </div>
        </div>
    </div>

    <!-- Card 2: Persentase LTC -->
    <div class="bg-white p-3 sm:p-5 md:p-6 rounded-2xl sm:rounded-[24px] border border-slate-100 shadow-sm flex flex-col justify-between cursor-pointer hover:-translate-y-1.5 hover:shadow-lg hover:border-indigo-200 active:scale-[0.97] transition-all duration-300 ease-out group" onclick="switchView('admin'); switchAdminTab('kelola-populasi');" title="Klik untuk lihat rincian populasi di Admin">
        <div>
            <div class="flex items-center gap-1.5 sm:gap-2">
                <span class="p-1.5 sm:p-2 rounded-lg bg-indigo-50 text-indigo-600 text-[10px] sm:text-xs group-hover:bg-indigo-100 transition-colors"><i class="fa-solid fa-percent"></i></span>
                <span class="text-[9px] sm:text-xs font-bold uppercase tracking-wider text-brand-textSub truncate">Persentase LTC</span>
            </div>
            <p class="text-lg sm:text-3xl md:text-4xl font-bold font-display text-brand-textMain mt-2 sm:mt-4" id="stat-persentase-ltc">0.00%</p>
        </div>
        <div class="flex items-center justify-between mt-2 sm:mt-3">
            <span id="populasi-tanggal-indicator" class="inline-flex items-center gap-1 px-1.5 sm:px-2 py-0.5 sm:py-1 bg-indigo-50 text-indigo-600 rounded-md sm:rounded-lg text-[8px] sm:text-[10px] font-semibold">
                <i class="fa-solid fa-clock-rotate-left text-[7px] sm:text-[9px]"></i> <span id="stat-persentase-ltc-date" class="truncate max-w-[50px] sm:max-w-none">Terbaru</span>
            </span>
            <div class="text-indigo-400 group-hover:text-indigo-600 transition-colors hidden sm:block">
                <i class="fa-solid fa-arrow-right text-xs sm:text-sm"></i>
            </div>
        </div>
    </div>

    <!-- Card 3: Biaya LTC Bulan Ini -->
    <div class="bg-white p-3 sm:p-5 md:p-6 rounded-2xl sm:rounded-[24px] border border-slate-100 shadow-sm flex flex-col justify-between cursor-pointer hover:-translate-y-1.5 hover:shadow-lg hover:border-orange-200 active:scale-[0.97] transition-all duration-300 ease-out group" onclick="switchView('keuangan')" title="Klik untuk kalkulator kustom">
        <div>
            <div class="flex items-center gap-1.5 sm:gap-2">
                <span class="p-1.5 sm:p-2 rounded-lg bg-orange-50 text-orange-600 text-[10px] sm:text-xs group-hover:bg-orange-100 transition-colors"><i class="fa-solid fa-wallet"></i></span>
                <span class="text-[9px] sm:text-xs font-bold uppercase tracking-wider text-brand-textSub truncate">Biaya LTC</span>
            </div>
            <p class="text-xs sm:text-xl md:text-2xl lg:text-3xl font-bold font-display text-brand-textMain mt-2 sm:mt-4 tracking-tight leading-tight truncate" id="stat-ltc-cost">MENGHITUNG...</p>
        </div>
        <div class="flex items-center justify-between mt-2 sm:mt-3">
            <span class="inline-flex items-center gap-1 px-1.5 sm:px-2 py-0.5 sm:py-1 bg-orange-50 text-orange-600 rounded-md sm:rounded-lg text-[8px] sm:text-[10px] font-semibold">
                <i class="fa-solid fa-calendar-day text-[7px] sm:text-[9px]"></i> <span id="stat-ltc-period-label" class="truncate max-w-[50px] sm:max-w-none">Bulan ini</span>
            </span>
            <div class="text-orange-400 group-hover:text-orange-600 transition-colors hidden sm:block">
                <i class="fa-solid fa-arrow-right text-xs sm:text-sm"></i>
            </div>
        </div>
    </div>
</div>

<!-- ============================================================ -->
<!-- BARIS 2: POPULASI LTC VS TOTAL KARYAWAN & REKAP ABSENSI SISWA -->
<!-- ============================================================ -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mt-6 animate-fadeIn">
    <!-- Populasi LTC vs Total Karyawan -->
    <div class="bg-white p-6 rounded-[24px] border border-slate-100 shadow-sm space-y-6">
        <!-- Header & Filter Bar -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-100">
            <div>
                <h3 class="font-display font-bold text-lg text-brand-textMain">Populasi LTC vs Total Karyawan</h3>
                <p class="text-xs text-brand-textSub mt-0.5">Perbandingan total seluruh karyawan, jumlah peserta LTC, dan rasio persentase</p>
            </div>

            <!-- Filter Panel -->
            <div class="flex flex-wrap items-center gap-2">
                <div class="flex items-center gap-1.5 bg-slate-50 border border-slate-200 rounded-xl px-2.5 py-1 shadow-sm">
                    <span class="text-[10px] font-bold uppercase text-brand-textSub">Mode:</span>
                    <select id="populasi-chart-filter-type" onchange="togglePopulasiFilterInputs()" class="bg-transparent text-xs font-semibold text-brand-textMain outline-none cursor-pointer">
                        <option value="all">Semua Data</option>
                        <option value="month-range">Range Bulan</option>
                        <option value="date-range">Filter Per Tanggal</option>
                    </select>
                </div>

                <div id="populasi-month-range-container" class="hidden flex items-center gap-1.5 bg-slate-50 border border-slate-200 rounded-xl px-2.5 py-1 shadow-sm">
                    <input type="month" id="populasi-filter-start-month" onchange="updateLtcRatioChart()" class="bg-transparent text-xs font-semibold text-brand-textMain outline-none">
                    <span class="text-slate-300">s/d</span>
                    <input type="month" id="populasi-filter-end-month" onchange="updateLtcRatioChart()" class="bg-transparent text-xs font-semibold text-brand-textMain outline-none">
                </div>

                <div id="populasi-date-range-container" class="hidden flex items-center gap-1.5 bg-slate-50 border border-slate-200 rounded-xl px-2.5 py-1 shadow-sm">
                    <input type="date" id="populasi-filter-start-date" onchange="updateLtcRatioChart()" class="bg-transparent text-xs font-semibold text-brand-textMain outline-none">
                    <span class="text-slate-300">s/d</span>
                    <input type="date" id="populasi-filter-end-date" onchange="updateLtcRatioChart()" class="bg-transparent text-xs font-semibold text-brand-textMain outline-none">
                </div>

                <button onclick="resetPopulasiChartFilter()" class="px-2.5 py-1 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-xl text-xs font-bold transition-all flex items-center gap-1">
                    <i class="fa-solid fa-rotate-left text-[10px]"></i>
                </button>
            </div>
        </div>

        <!-- Chart Canvas -->
        <div class="relative h-72">
            <canvas id="ltcRatioChart"></canvas>
        </div>

        <!-- Tabel Order per Bulan -->
        <div class="pt-4 border-t border-slate-100">
            <div class="flex items-center justify-between mb-3">
                <h4 class="font-display font-bold text-xs text-brand-textMain flex items-center gap-2">
                    <i class="fa-solid fa-list-check text-brand-blue"></i>
                    Total Order Populasi per Bulan
                </h4>
                <span id="populasi-order-filter-indicator" class="text-[10px] font-semibold text-brand-textSub bg-slate-100 px-2 py-0.5 rounded-full">Semua Periode</span>
            </div>
            
            <div class="overflow-x-auto rounded-xl border border-slate-200/80">
                <table class="w-full text-left text-xs border-collapse">
                    <thead>
                        <tr id="populasi-order-thead-tr" class="bg-slate-100/80 text-brand-textMain font-bold border-b border-slate-200">
                            <th class="py-2.5 px-3 uppercase text-[10px] font-extrabold w-32 bg-slate-200/70 text-slate-700 border-r border-slate-200">bulan</th>
                        </tr>
                    </thead>
                    <tbody id="populasi-order-tbody" class="divide-y divide-slate-100 font-semibold">
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Rekap Absensi Siswa -->
    <div class="bg-white p-6 rounded-[24px] border border-slate-100 shadow-sm space-y-6">
        <!-- Header & Filter Bar -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-100">
            <div>
                <h3 class="font-display font-bold text-lg text-brand-textMain">Rekap Absensi Siswa</h3>
                <p class="text-xs text-brand-textSub mt-0.5">Perbandingan total kehadiran, ketidakhadiran, dan rasio absensi</p>
            </div>

            <!-- Filter Panel -->
            <div class="flex flex-wrap items-center gap-2">
                <div class="flex items-center gap-1.5 bg-slate-50 border border-slate-200 rounded-xl px-2.5 py-1 shadow-sm">
                    <span class="text-[10px] font-bold uppercase text-brand-textSub">Mode:</span>
                    <select id="absensi-chart-filter-type" onchange="toggleAbsensiFilterInputs()" class="bg-transparent text-xs font-semibold text-brand-textMain outline-none cursor-pointer">
                        <option value="all">Semua Data</option>
                        <option value="month-range">Range Bulan</option>
                        <option value="date-range">Filter Per Tanggal</option>
                    </select>
                </div>

                <div id="absensi-month-range-container" class="hidden flex items-center gap-1.5 bg-slate-50 border border-slate-200 rounded-xl px-2.5 py-1 shadow-sm">
                    <input type="month" id="absensi-chart-start-month" onchange="updateAbsensiChart()" class="bg-transparent text-xs font-semibold text-brand-textMain outline-none">
                    <span class="text-slate-300">s/d</span>
                    <input type="month" id="absensi-chart-end-month" onchange="updateAbsensiChart()" class="bg-transparent text-xs font-semibold text-brand-textMain outline-none">
                </div>

                <div id="absensi-date-range-container" class="hidden flex items-center gap-1.5 bg-slate-50 border border-slate-200 rounded-xl px-2.5 py-1 shadow-sm">
                    <input type="date" id="absensi-chart-start-date" onchange="updateAbsensiChart()" class="bg-transparent text-xs font-semibold text-brand-textMain outline-none">
                    <span class="text-slate-300">s/d</span>
                    <input type="date" id="absensi-chart-end-date" onchange="updateAbsensiChart()" class="bg-transparent text-xs font-semibold text-brand-textMain outline-none">
                </div>

                <button onclick="resetAbsensiChartFilter()" class="px-2.5 py-1 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-xl text-xs font-bold transition-all flex items-center gap-1">
                    <i class="fa-solid fa-rotate-left text-[10px]"></i>
                </button>
            </div>
        </div>

        <!-- Chart Canvas -->
        <div class="relative h-72">
            <canvas id="absensiChart"></canvas>
        </div>

        <!-- Breakdown Tingkat Kehadiran Per Kelas -->
        <div class="pt-4 border-t border-slate-100">
            <div class="flex items-center justify-between mb-3">
                <h4 class="font-display font-bold text-xs text-brand-textMain flex items-center gap-2">
                    <i class="fa-solid fa-graduation-cap text-indigo-500"></i>
                    Tingkat Kehadiran per Kelas
                </h4>
                <span class="text-[10px] font-semibold text-indigo-600 bg-indigo-50 px-2 py-0.5 rounded-full border border-indigo-100">Persentase Hadir</span>
            </div>
            
            <div id="absensi-class-breakdown-container" class="grid grid-cols-2 sm:grid-cols-5 gap-2">
                <!-- Dipopulasikan secara dinamis oleh updateAbsensiChart() -->
            </div>
        </div>
    </div>
</div>

