            </span>
            <div class="text-indigo-400 group-hover:text-indigo-600 transition-colors hidden sm:block">
                <i class="fa-solid fa-arrow-right text-xs"></i>
            </div>
        </div>
    </div>

    <!-- Card 3: Biaya LTC Bulan Ini -->
    <div class="bg-white p-3 sm:py-3.5 sm:px-4 md:py-3.5 md:px-5 rounded-2xl md:rounded-[20px] border border-slate-100 shadow-sm flex flex-col justify-between cursor-pointer hover:-translate-y-1 hover:shadow-md hover:border-orange-200 active:scale-[0.97] transition-all duration-300 ease-out group" onclick="switchView('keuangan')" title="Klik untuk kalkulator kustom">
        <div>
            <div class="flex items-center gap-1.5 sm:gap-2">
                <span class="p-1 sm:p-1.5 rounded-lg bg-orange-50 text-orange-600 text-[10px] sm:text-xs group-hover:bg-orange-100 transition-colors"><i class="fa-solid fa-wallet"></i></span>
                <span class="text-[9px] sm:text-xs font-bold uppercase tracking-wider text-brand-textSub truncate">Biaya LTC</span>
            </div>
            <p class="text-[10px] xs:text-xs sm:text-xl md:text-2xl font-bold font-display text-brand-textMain mt-1 sm:mt-2 tracking-tight leading-tight truncate" id="stat-ltc-cost">MENGHITUNG...</p>
        </div>
        <div class="flex items-center justify-between mt-1.5 sm:mt-2">
            <span class="inline-flex items-center gap-1 px-1.5 sm:px-2 py-0.5 bg-orange-50 text-orange-600 rounded-md sm:rounded-lg text-[8px] sm:text-[10px] font-semibold">
                <i class="fa-solid fa-calendar-day text-[7px] sm:text-[9px]"></i> <span id="stat-ltc-period-label" class="truncate max-w-[50px] sm:max-w-none">Bulan ini</span>
            </span>
            <div class="text-orange-400 group-hover:text-orange-600 transition-colors hidden sm:block">
                <i class="fa-solid fa-arrow-right text-xs"></i>
            </div>
        </div>
    </div>
</div>

