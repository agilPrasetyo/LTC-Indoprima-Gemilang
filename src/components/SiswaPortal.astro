                        </div>

                        <!-- Multi Product Rows Wrapper -->
                        <div class="space-y-3">
                            <div class="flex items-center justify-between">
                                <label class="text-xs font-bold uppercase tracking-wider text-slate-600">Model Produk & Target</label>
                                <span class="text-[11px] text-slate-400 italic">Target terkunci otomatis dari master data</span>
                            </div>

                            <div id="produksi-products-list" class="space-y-3">
