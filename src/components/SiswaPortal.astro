                                    <option value="PAINTING">PAINTING</option>
                                    <option value="CORE">CORE</option>
                                    <option value="SHOTBLAST">SHOTBLAST</option>
                                    <option value="FURAN">FURAN</option>
                                    <option value="FETTLING">FETTLING</option>
                                    <option value="CNC / MACHINING">CNC / MACHINING</option>
                                    <option value="MELTING">MELTING</option>
                                    <option value="GALAH IBK">GALAH IBK</option>
                                    <option value="PPIC">PPIC</option>
                                    <option value="ADM PPIC">ADM PPIC</option>
                                    <option value="ADM PRODUKSI">ADM PRODUKSI</option>
                                </optgroup>
                                <optgroup label="── DEPARTEMEN ENGINEERING ──">
                                    <option value="PATTERN">PATTERN</option>
                                    <option value="LADLE">LADLE</option>
                                    <option value="MAINTENANCE">MAINTENANCE</option>
                                    <option value="ADM MAINTENANCE">ADM MAINTENANCE</option>
                                    <option value="ENGINEERING DRAFTER">ENGINEERING DRAFTER</option>
                                </optgroup>
                                <optgroup label="── DEPARTEMEN PERSONALIA & SHE ──">
                                    <option value="IRGA">IRGA</option>
                                    <option value="SHE (SAFETY K3)">SHE (SAFETY K3)</option>
                                </optgroup>
                                <optgroup label="── DEPARTEMEN QUALITY CONTROL (QC) ──">
                                    <option value="QC POURING">QC POURING</option>
                                    <option value="QC LAB PASIR">QC LAB PASIR</option>
                                    <option value="QC LAB LOGAM">QC LAB LOGAM</option>
                                </optgroup>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- STEP 3 CONTAINER -->
                <div id="step-container-3" class="step-container space-y-6 hidden">
                    <h4 class="text-sm font-bold text-slate-800 uppercase tracking-wider border-b border-slate-100 pb-2 flex items-center justify-between">
                        <span id="step3-section-title">Hasil & Validasi Pekerjaan</span>
                        <span id="step3-section-badge" class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-blue-50 text-blue-600">Lini Produksi</span>
                    </h4>

                    <!-- 1. DYNAMIC CONTAINER: LINI PRODUKSI (MULTI-PRODUK + AUTO TARGET) -->
                    <div id="container-mode-produksi" class="space-y-4">
                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-1.5">Nomor Mesin / Line</label>
                            <input type="text" id="input-siswa-mesin" placeholder="Contoh: GRINDA-02 / CNC-01 / LINE-A"
