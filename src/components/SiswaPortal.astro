                                    <option value="Shift 1">Shift 1 (Pagi)</option>
                                    <option value="Shift 2">Shift 2 (Siang)</option>
                                    <option value="Shift 3">Shift 3 (Malam)</option>
                                </select>
                            </div>
                        </div>
                        
                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-1.5">Bagian / Section Kerja</label>
                            <select id="input-siswa-bagian" required onchange="onSiswaBagianChanged()"
