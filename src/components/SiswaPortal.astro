                            <i class="fa-solid fa-book-open-reader text-blue-600 text-sm"></i>
                            <span>Tutorial Pengisian</span>
                        </button>
                        <button type="button" onclick="openAdminWhatsAppHelp()" class="w-full py-2.5 px-3 bg-emerald-50 hover:bg-emerald-100 text-emerald-700 border border-emerald-200/80 rounded-xl text-[11px] sm:text-xs font-bold flex items-center justify-center gap-1.5 transition-all duration-300 shadow-sm cursor-pointer">
                            <i class="fa-brands fa-whatsapp text-emerald-600 text-base flex-shrink-0"></i>
                            <span class="truncate">Jika Butuh Bantuan Hubungi Admin</span>
                        </button>
                    </div>
                </div>
            </div>

            <div class="mt-4 pt-3 border-t border-slate-200/60 text-[10px] text-slate-400 leading-relaxed bg-blue-50/50 border border-blue-100/80 p-2.5 rounded-xl flex items-center gap-2">
                <i class="fa-solid fa-shield-halved text-blue-600 text-xs flex-shrink-0"></i>
                <span>Data disimpan langsung ke database pusat.</span>
            </div>
        </div>

        <!-- Panel Kanan: Form Area -->
        <div class="md:col-span-8 p-5 sm:p-8 flex flex-col justify-between relative">
            <form id="form-siswa-daily" onsubmit="event.preventDefault();" class="h-full flex flex-col justify-between gap-6">
                
                <!-- STEP 1 CONTAINER -->
                <div id="step-container-1" class="step-container space-y-6">
                    <h4 class="text-sm font-bold text-slate-800 uppercase tracking-wider border-b border-slate-100 pb-2">Identitas Siswa</h4>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-1.5">Nama Lengkap</label>
                            <input type="text" id="input-siswa-nama" readonly disabled
                                class="w-full px-4 py-3 bg-slate-100 border border-slate-200 rounded-xl text-xs font-semibold text-slate-600 outline-none">
                        </div>
                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-1.5">Nomor Registrasi</label>
                            <input type="text" id="input-siswa-noreg" readonly disabled
                                class="w-full px-4 py-3 bg-slate-100 border border-slate-200 rounded-xl text-xs font-semibold text-slate-600 outline-none">
                        </div>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-1.5">Kelas</label>
                            <input type="text" id="input-siswa-kelas" readonly disabled
                                class="w-full px-4 py-3 bg-slate-100 border border-slate-200 rounded-xl text-xs font-semibold text-slate-600 outline-none">
                        </div>
                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-1.5">Tanggal Masuk LTC</label>
                            <input type="text" id="input-siswa-masuk" readonly disabled
                                class="w-full px-4 py-3 bg-slate-100 border border-slate-200 rounded-xl text-xs font-semibold text-slate-600 outline-none">
                        </div>
                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-1.5">Tanggal Berakhir LTC</label>
                            <input type="text" id="input-siswa-keluar" readonly disabled
                                class="w-full px-4 py-3 bg-slate-100 border border-slate-200 rounded-xl text-xs font-semibold text-slate-600 outline-none">
                        </div>
                    </div>

                    <!-- Catatan Absensi Siswa (Sakit, Ijin, Alpha) -->
                    <div class="hidden p-4 bg-slate-50 border border-slate-200/80 rounded-2xl space-y-2.5">
                        <div class="flex items-center justify-between">
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-700 flex items-center gap-1.5">
                                <i class="fa-solid fa-clipboard-user text-blue-600"></i>
                                <span>Catatan Absensi Siswa</span>
                            </label>
                            <span class="text-[10px] text-slate-400 font-semibold">Akumulasi Selama Program LTC</span>
                        </div>
                        <div class="grid grid-cols-3 gap-3">
                            <!-- 1. Sakit -->
                            <div class="bg-amber-50/90 border border-amber-200 p-3 rounded-xl flex items-center justify-between shadow-sm">
                                <div>
                                    <span class="text-[10px] font-bold uppercase text-amber-700 block">Sakit</span>
                                    <span id="input-siswa-rekap-sakit" class="text-sm font-extrabold text-amber-900">0 Hari</span>
                                </div>
                                <div class="w-8 h-8 rounded-lg bg-amber-100/80 flex items-center justify-center text-amber-600 font-bold text-xs">
                                    <i class="fa-solid fa-briefcase-medical"></i>
                                </div>
                            </div>

                            <!-- 2. Ijin -->
                            <div class="bg-sky-50/90 border border-sky-200 p-3 rounded-xl flex items-center justify-between shadow-sm">
                                <div>
                                    <span class="text-[10px] font-bold uppercase text-sky-700 block">Ijin</span>
                                    <span id="input-siswa-rekap-ijin" class="text-sm font-extrabold text-sky-900">0 Hari</span>
                                </div>
                                <div class="w-8 h-8 rounded-lg bg-sky-100/80 flex items-center justify-center text-sky-600 font-bold text-xs">
                                    <i class="fa-solid fa-envelope-open-text"></i>
                                </div>
                            </div>

                            <!-- 3. Alpha -->
                            <div class="bg-rose-50/90 border border-rose-200 p-3 rounded-xl flex items-center justify-between shadow-sm">
                                <div>
                                    <span class="text-[10px] font-bold uppercase text-rose-700 block">Alpha</span>
                                    <span id="input-siswa-rekap-alpha" class="text-sm font-extrabold text-rose-900">0 Hari</span>
                                </div>
                                <div class="w-8 h-8 rounded-lg bg-rose-100/80 flex items-center justify-center text-rose-600 font-bold text-xs">
                                    <i class="fa-solid fa-user-xmark"></i>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Konfirmasi Kehadiran Sebelum Laporan -->
                    <div class="space-y-4 pt-4 border-t border-slate-100">
                        <label class="block text-xs font-bold uppercase tracking-wider text-slate-800">Status Kehadiran Hari Ini</label>
                        <div class="grid grid-cols-3 gap-3">
                            <label class="flex items-center justify-center gap-2 px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl cursor-pointer hover:bg-slate-100 transition-all duration-200" id="label-kehadiran-hadir">
                                <input type="radio" name="siswa-kehadiran" value="Hadir" checked onchange="toggleKehadiranSiswa('Hadir')" class="w-4 h-4 text-blue-600">
                                <span class="text-xs font-bold text-slate-700">Hadir</span>
                            </label>
                            <label class="flex items-center justify-center gap-2 px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl cursor-pointer hover:bg-slate-100 transition-all duration-200" id="label-kehadiran-ijin">
                                <input type="radio" name="siswa-kehadiran" value="Ijin" onchange="toggleKehadiranSiswa('Ijin')" class="w-4 h-4 text-blue-600">
                                <span class="text-xs font-bold text-slate-700">Ijin</span>
                            </label>
                            <label class="flex items-center justify-center gap-2 px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl cursor-pointer hover:bg-slate-100 transition-all duration-200" id="label-kehadiran-sakit">
                                <input type="radio" name="siswa-kehadiran" value="Sakit" onchange="toggleKehadiranSiswa('Sakit')" class="w-4 h-4 text-blue-600">
                                <span class="text-xs font-bold text-slate-700">Sakit</span>
                            </label>
                        </div>
                        
                        <div id="siswa-ket-absen-container" class="hidden space-y-4">
                            <div class="space-y-2">
                                <label class="block text-xs font-bold uppercase tracking-wider text-slate-800 flex items-center gap-2">
                                    <i class="fa-solid fa-calendar-days text-blue-600"></i> Tanggal Ijin / Sakit
