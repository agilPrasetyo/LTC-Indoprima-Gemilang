                                <i class="fa-solid fa-plus text-[10px]"></i> Tambah Model Produk Lain
                            </button>
                        </div>

                        <!-- Live Summary Card -->
                        <!-- Summary Stats Cards (Plan, Actual, Reject only) -->
                        <div class="p-3.5 bg-gradient-to-br from-slate-50 to-blue-50/30 border border-slate-200/80 rounded-2xl">
                            <div class="grid grid-cols-3 gap-2.5 text-center">
                                <div class="bg-white/80 p-2.5 rounded-xl border border-slate-100 shadow-sm">
                                    <div class="text-[10px] uppercase font-bold text-slate-400">Total Plan</div>
                                    <div id="summary-total-plan" class="text-sm sm:text-base font-extrabold text-blue-600">0</div>
                                </div>
                                <div class="bg-white/80 p-2.5 rounded-xl border border-slate-100 shadow-sm">
                                    <div class="text-[10px] uppercase font-bold text-slate-400">Total Aktual</div>
                                    <div id="summary-total-aktual" class="text-sm sm:text-base font-extrabold text-emerald-600">0</div>
