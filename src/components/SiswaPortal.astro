                        <div id="step-pill-3" class="flex items-center justify-center gap-1 sm:gap-1.5 px-2 py-1.5 rounded-xl text-[10px] sm:text-xs font-bold bg-white text-slate-400 border border-slate-200/80 transition-all duration-300">
