  "questions": [
    {
      "id": "q-furan-01",
      "section_id": "sec-furan",
      "question": "Fungsi dari resin dan hardener pada proses pembuatan cetakan pasir furan adalah?",
      "options": {
        "A": "Sebagai bahan pewarna pasir",
        "B": "Sebagai pengikat (binder) agar pasir mengeras secara kimiawi",
        "C": "Sebagai pelumas logam cair",
        "D": "Sebagai bahan pembersih debu cetakan"
      },
      "correct_answer": "B"
    },
    {
      "id": "q-furan-02",
      "section_id": "sec-furan",
      "question": "Cacat coran 'gas hole' pada cetakan furan umumnya disebabkan oleh?",
      "options": {
        "A": "Pengeringan cetakan yang terlalu sempurna",
        "B": "Ventilasi udara pada cetakan kurang atau kelembapan pasir terlalu tinggi",
        "C": "Temperatur penuangan logam terlalu tinggi",
        "D": "Jumlah pasir terlalu padat"
      },
      "correct_answer": "B"
    },
    {
      "id": "q-1788833676109-uwo5",
      "section_id": "sec-grinding",
      "question": "Apa definisi dari proses melting dalam alur pengecoran logam?",
      "options": {
        "A": "Proses pencampuran pasir untuk cetakan",
        "B": "Proses peleburan bahan baku menjadi cairan besi cor",
        "C": "Proses pemisahan produk dari sistem saluran tuang",
        "D": "Proses pembersihan sisa pasir pada produk"
      },
      "correct_answer": "B"
    },
    {
      "id": "q-1788833676109-82e4",
      "section_id": "sec-grinding",
      "question": "Manakah kelompok material yang ditambahkan secara khusus untuk menyesuaikan komposisi kimia cairan besi cor agar memenuhi standar spesifikasi?",
      "options": {
        "A": "Steel Scrap",
        "B": "Return Scrap",
        "C": "Alloy Material (seperti C, Fe-Si, Fe-Mn, Cu, Sn, S, Fe-Cr)",
        "D": "Sand Mold"
      },
      "correct_answer": "C"
    },
    {
      "id": "q-1788833676109-12vq",
      "section_id": "sec-grinding",
      "question": "Bagaimana karakteristik utama dari tipe material FC (Ferro Casting) atau besi cor kelabu?",
      "options": {
        "A": "Ulet (tidak mudah patah) dan berkekuatan tinggi",
        "B": "Getas (mudah patah), keras, dan tahan gores",
        "C": "Memiliki keuletan dan kekuatan yang sangat tinggi",
        "D": "Sangat elastis dan mudah dibengkokkan"
      },
      "correct_answer": "B"
    },
    {
      "id": "q-1788833676109-5v2s",
      "section_id": "sec-grinding",
      "question": "Komponen kendaraan seperti Body Caliper dan Bracket merupakan contoh aplikasi penting dari tipe material...",
      "options": {
        "A": "FC (Ferro Casting)",
        "B": "FCD (Ferro Casting Ductile)",
        "C": "Steel Casting",
        "D": "Grey Iron Casting"
      },
      "correct_answer": "B"
    },
    {
      "id": "q-1788833676109-vur3",
      "section_id": "sec-grinding",
      "question": "Bentuk grafit seperti apakah yang terlihat pada pengujian struktur mikro material FCD (Ferro Casting Ductile) dengan perbesaran 100x?",
      "options": {
        "A": "Berbentuk flake (cacing)",
        "B": "Berbentuk nodular (bulat)",
        "C": "Berbentuk serat acak",
        "D": "Tidak memiliki struktur grafit"
      },
      "correct_answer": "B"
    }
  ],
